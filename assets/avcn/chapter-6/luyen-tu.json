de","vi":"điện cực (que hàn gắn trên kìm hàn)","ipa":"/ɪˈlektrəʊd/","audio":"/assets/avcn/chapter-6/audio/b18e4d51c7.mp3"},{"term":"flux","vi":"thuốc hàn (lớp bọc que hàn)","ipa":"/flʌks/","audio":"/assets/avcn/chapter-6/audio/9561822667.mp3"},{"term":"shielding gas","vi":"khí bảo vệ","ipa":"/ˈʃiːldɪŋ ɡæs/","audio":"/assets/avcn/chapter-6/audio/bd83b3ccbf.mp3"},{"term":"tungsten electrode","vi":"điện cực vonfram","ipa":"/ˈtʌŋstən ɪˈlektrəʊd/","audio":"/assets/avcn/chapter-6/audio/c6ca1d4fc2.mp3"},{"term":"consumable","vi":"bị tiêu hao (dùng hết khi hàn)","ipa":"/kənˈsjuːməbl/","audio":"/assets/avcn/chapter-6/audio/2ca660d671.mp3"}],"them":[{"term":"welding apron","vi":"tạp dề hàn (yếm da chống tia lửa)"},{"term":"electrode holder","vi":"kìm hàn (tay cầm kẹp que hàn)"},{"term":"chipping hammer","vi":"búa gõ xỉ hàn"},{"term":"wire brush","vi":"bàn chải sắt (chải sạch xỉ và gỉ)"},{"term":"gas regulator","vi":"van giảm áp (đồng hồ khí)"},{"term":"arc","vi":"hồ quang"},{"term":"torch","vi":"mỏ hàn, đèn khò (tiếng Anh Anh còn là đèn pin)"},{"term":"oxyfuel / oxyacetylene","vi":"hỗn hợp oxy và khí đốt / oxy và axetylen"},{"term":"acetylene","vi":"khí axetylen (C₂H₂)"},{"term":"argon","vi":"khí argon (Ar), khí trơ"},{"term":"carbon dioxide","vi":"khí cacbonic (CO₂)"},{"term":"stick welding (SMAW)","vi":"hàn que, hàn hồ quang tay"},{"term":"MIG welding (GMAW)","vi":"hàn MIG, hàn dây trong khí bảo vệ"},{"term":"TIG welding (GTAW)","vi":"hàn TIG, điện cực vonfram"},{"term":"fusion","vi":"sự nóng chảy kết dính"},{"term":"non-consumable","vi":"không bị tiêu hao"}]}
