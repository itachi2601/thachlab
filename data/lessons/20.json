olor\" stroke-width=\"1.2\" opacity=\".4\"/><line x1=\"258\" y1=\"121\" x2=\"250\" y2=\"129\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".4\"/><line x1=\"274\" y1=\"121\" x2=\"266\" y2=\"129\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".4\"/><line x1=\"290\" y1=\"121\" x2=\"282\" y2=\"129\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".4\"/><line x1=\"306\" y1=\"121\" x2=\"298\" y2=\"129\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".4\"/><line x1=\"322\" y1=\"121\" x2=\"314\" y2=\"129\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".4\"/><line x1=\"338\" y1=\"121\" x2=\"330\" y2=\"129\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".4\"/><line x1=\"354\" y1=\"121\" x2=\"346\" y2=\"129\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".4\"/><line x1=\"370\" y1=\"121\" x2=\"362\" y2=\"129\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".4\"/><polyline points=\"22,100 31,86 50,114 69,86 88,114 107,86 125,114 144,86 163,114 182,86 201,114 210,100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"210\" y=\"80\" width=\"40\" height=\"40\" rx=\"4\" fill=\"rgba(148,163,184,.3)\" stroke=\"currentColor\" stroke-width=\"2.5\"/><rect x=\"110\" y=\"80\" width=\"40\" height=\"40\" rx=\"4\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"2\" stroke-dasharray=\"5,4\"/><rect x=\"310\" y=\"80\" width=\"40\" height=\"40\" rx=\"4\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"2\" stroke-dasharray=\"5,4\"/><line x1=\"20\" y1=\"152\" x2=\"410\" y2=\"152\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M401.3,147.0 L410.0,152.0 L401.3,157.0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"130\" y1=\"130\" x2=\"130\" y2=\"156\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-dasharray=\"3,3\" opacity=\".5\"/><text x=\"130\" y=\"176\" fill=\"#fb923c\" font-size=\"15\" font-weight=\"700\" text-anchor=\"middle\">−A</text><line x1=\"230\" y1=\"130\" x2=\"230\" y2=\"156\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-dasharray=\"3,3\" opacity=\".5\"/><text x=\"230\" y=\"176\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"middle\">O</text><line x1=\"330\" y1=\"130\" x2=\"330\" y2=\"156\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-dasharray=\"3,3\" opacity=\".5\"/><text x=\"330\" y=\"176\" fill=\"#fb923c\" font-size=\"15\" font-weight=\"700\" text-anchor=\"middle\">+A</text><text x=\"408\" y=\"176\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"end\">x</text><line x1=\"204\" y1=\"62\" x2=\"134\" y2=\"62\" stroke=\"#34d399\" stroke-width=\"2.5\"/><path d=\"M143.1,67.2 L134.0,62.0 L143.1,56.8\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2.5\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"256\" y1=\"62\" x2=\"326\" y2=\"62\" stroke=\"#34d399\" stroke-width=\"2.5\"/><path d=\"M316.9,56.8 L326.0,62.0 L316.9,67.2\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2.5\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"230\" y=\"36\" fill=\"#34d399\" font-size=\"15\" font-weight=\"600\" text-anchor=\"middle\">dao động qua lại</text><text x=\"230\" y=\"204\" fill=\"currentColor\" font-size=\"14\" font-weight=\"500\" text-anchor=\"middle\">O là vị trí cân bằng</text></svg><figcaption>Hình 1. Con lắc lò xo: vật dao động quanh vị trí cân bằng O, giữa hai biên −A và +A.</figcaption></figure>\n\n<div class=\"tl-box tl-keep tl-chot\">\n<p class=\"tl-label\">Chốt mục</p>\n<p class=\"tl-chot-h\">🎯 Cần nắm</p>\n<details class=\"tl-details tl-more\">\n<summary>Dao động cơ là gì?</summary>\n<p>Chuyển động qua lại quanh một vị trí cân bằng.</p>\n</details>\n<details class=\"tl-details tl-more tl-chot-ghi\">\n<summary>✍️ Tập ô 1·4 · đối chiếu 2 dòng</summary>\n<ul>\n<li>Dao động cơ: chuyển động <strong>qua lại</strong> quanh một <strong>vị trí cân bằng</strong> (VTCB).</li>\n<li>Thí nghiệm: chỗ vật đứng yên ban đầu là VTCB; vật đi qua lại giữa hai biên $-A$ và $+A$.</li>\n</ul>\n</details>\n</div>\n\n<h4 data-tap=\"2.1\">2. Dao động tuần hoàn</h4>\n<p class=\"tl-claim\">Tuần hoàn là lặp lại sau những thời gian bằng nhau.</p>\n<p><strong>🔑 Thời gian bằng nhau · Về chỗ cũ · Theo hướng cũ</strong></p>\n<table class=\"tl-table\">\n<thead><tr><th>Loại</th><th>Ví dụ</th><th>Vì sao</th></tr></thead>\n<tbody>\n<tr><td>Tuần hoàn</td><td>con lắc đồng hồ</td><td>lặp lại đều đặn</td></tr>\n<tr><td>Không tuần hoàn</td><td>cành cây đu đưa khi gió thổi</td><td>lúc mạnh lúc yếu, không lặp</td></tr>\n</tbody>\n</table>\n<details class=\"tl-details tl-more\">\n<summary>Đoán thử: cái đu đẩy mạnh dần rồi yếu dần có tuần hoàn không?</summary>\n<p>Không, vì mỗi lần đi về lại khác lần trước, chuyển động không lặp lại đều đặn.</p>\n<p>Còn nhanh chậm trong cùng một lần đi về (như cái đu ở Mở bài) thì vẫn tuần hoàn.</p>\n</details>\n<details class=\"tl-details tl-more\">\n<summary>Đoán thử: đu qua chỗ cũ nhưng đi ngược chiều thì đã lặp lại chưa?</summary>\n<p>Chưa. Phải đợi lần kế tiếp đu qua chỗ đó theo đúng chiều cũ mới tính là lặp lại.</p>\n</details>\n<div class=\"tl-box tl-box--rule tl-note\">\n<p class=\"tl-label\">📘 Dao động điều hoà</p>\n<p><strong>Dao động tuần hoàn đơn giản nhất</strong>, mô tả bằng <span class=\"tl-term\"><input type=\"checkbox\" id=\"tl1-t1\"><label for=\"tl1-t1\">hàm côsin</label><span class=\"tl-def\">hàm cos của một góc, nhận giá trị từ −1 đến 1 và lặp lại sau mỗi 2π.</span></span>.</p>\n</div>\n<div class=\"tl-box tl-keep tl-chot\">\n<p class=\"tl-label\">Chốt mục</p>\n<p class=\"tl-chot-h\">🎯 Cần nắm</p>\n<details class=\"tl-details tl-more\">\n<summary>Dao động tuần hoàn là gì?</summary>\n<p>Sau những khoảng thời gian bằng nhau, vật trở lại vị trí cũ theo hướng cũ.</p>\n</details>\n<details class=\"tl-details tl-more tl-chot-ghi\">\n<summary>✍️ Tập ô 2·1 · đối chiếu 3 dòng</summary>\n<ul>\n<li>Tuần hoàn: sau những khoảng thời gian <strong>bằng nhau</strong>, vật trở lại vị trí <strong>cũ</strong> theo <strong>hướng cũ</strong>.</li>\n<li>Con lắc đồng hồ, cái đu cứ 3 s lại như cũ: tuần hoàn. Cành cây trong gió, đu đẩy mạnh dần rồi yếu dần: không.</li>\n<li>Dao động điều hoà: tuần hoàn đơn giản nhất, li độ biến thiên theo hàm <strong>côsin</strong> của thời gian.</li>\n</ul>\n</details>\n</div>\n\n<h4 data-tap=\"2.2-3\">3. Đồ thị li độ – thời gian</h4>\n<p class=\"tl-claim\">Đồ thị li độ theo thời gian là đường hình sin.</p>\n<p><strong>🔑 Đường hình sin · Biên độ A · Chu kì T</strong></p>\n<p>$x$ (li độ): vị trí của vật so với VTCB, có thể âm.</p>\n<div class=\"tl-box tl-box--exp tl-note\" data-exp=\"tn-l11-daodongdieuhoa-02\">\n<p class=\"tl-label\">🔬 Thí nghiệm: vật tự vẽ đồ thị</p>\n<ol class=\"tl-steps\">\n<li><strong>Làm:</strong> gắn bút lên vật dao động, kéo tờ giấy chạy đều qua đầu bút.</li>\n<li><strong>Quan sát:</strong> nét bút vẽ ra đường lượn sóng đều đặn.</li>\n<li><strong>Rút ra:</strong> đồ thị li độ theo thời gian có dạng <strong>hình sin</strong>.</li>\n</ol>\n</div>\n<!--video:tn-l11-daodongdieuhoa-02-->\n<div class=\"tl-box tl-box--video\">\n<p class=\"tl-label\">🎬 Xem thí nghiệm thật: bút vẽ đồ thị dao động</p>\n<div class=\"tl-video\"><iframe src=\"https://www.youtube-nocookie.com/embed/MSpCJ95sWEc?rel=0\" title=\"bút vẽ đồ thị dao động\" loading=\"lazy\" allow=\"encrypted-media; picture-in-picture; fullscreen\" allowfullscreen></iframe></div>\n<p><strong>Nhìn vào:</strong> Đường bút vẽ trên giấy trông thế nào?</p>\n</div>\n\n<figure class=\"fig\" data-tl=\"1\"><svg viewBox=\"0 0 360 258\" role=\"img\" aria-label=\"Vật treo lò xo dao động lên xuống, bút gắn vào vật vẽ lên tờ giấy chạy đều sang trái một đường hình sin; trục đứng là li độ x từ −A đến A, khoảng giữa hai đỉnh liên tiếp là một chu kì T\"><rect x=\"16\" y=\"62\" width=\"284\" height=\"160\" rx=\"3\" fill=\"rgba(148,163,184,.12)\" stroke=\"currentColor\" stroke-width=\"1.5\" opacity=\".7\"/><line x1=\"48\" y1=\"214\" x2=\"48\" y2=\"76\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M43.5,81.8 L48.0,74.0 L52.5,81.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"48\" y1=\"150\" x2=\"268\" y2=\"150\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M262.2,145.5 L270.0,150.0 L262.2,154.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"36\" y=\"84\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"end\">x</text><text x=\"275\" y=\"143\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"start\">t</text><line x1=\"44\" y1=\"100\" x2=\"52\" y2=\"100\" stroke=\"currentColor\" stroke-width=\"1.6\"/><text x=\"39\" y=\"105\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"end\">A</text><line x1=\"44\" y1=\"150\" x2=\"52\" y2=\"150\" stroke=\"currentColor\" stroke-width=\"1.6\"/><text x=\"39\" y=\"155\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"end\">O</text><line x1=\"44\" y1=\"200\" x2=\"52\" y2=\"200\" stroke=\"currentColor\" stroke-width=\"1.6\"/><text x=\"39\" y=\"205\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"end\">−A</text><polyline points=\"56,100.0 58,100.5 60,102.0 62,104.5 64,107.9 66,112.2 68,117.3 70,123.0 72,129.2 74,135.9 76,142.9 78,150.0 80,157.1 82,164.1 84,170.8 86,177.0 88,182.7 90,187.8 92,192.1 94,195.5 96,198.0 98,199.5 100,200.0 102,199.5 104,198.0 106,195.5 108,192.1 110,187.8 112,182.7 114,177.0 116,170.8 118,164.1 120,157.1 122,150.0 124,142.9 126,135.9 128,129.2 130,123.0 132,117.3 134,112.2 136,107.9 138,104.5 140,102.0 142,100.5 144,100.0 146,100.5 148,102.0 150,104.5 152,107.9 154,112.2 156,117.3 158,123.0 160,129.2 162,135.9 164,142.9 166,150.0 168,157.1 170,164.1 172,170.8 174,177.0 176,182.7 178,187.8 180,192.1 182,195.5 184,198.0 186,199.5 188,200.0 190,199.5 192,198.0 194,195.5 196,192.1 198,187.8 200,182.7 202,177.0 204,170.8 206,164.1 208,157.1 210,150.0 212,142.9 214,135.9 216,129.2 218,123.0 220,117.3 222,112.2 224,107.9 226,104.5 228,102.0 230,100.5 232,100.0 234,100.5 236,102.0 238,104.5 240,107.9 242,112.2 244,117.3 246,123.0 248,129.2 250,135.9 252,142.9 254,150.0 256,157.1 258,164.1 260,170.8 262,177.0 264,182.7 266,187.8 268,192.1 270,195.5 272,198.0 274,199.5 276,200.0 278,199.5 280,198.0 282,195.5 284,192.1\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.4\"/><line x1=\"144\" y1=\"96\" x2=\"144\" y2=\"80\" stroke=\"#fb923c\" stroke-width=\"1.4\"/><line x1=\"232\" y1=\"96\" x2=\"232\" y2=\"80\" stroke=\"#fb923c\" stroke-width=\"1.4\"/><line x1=\"146\" y1=\"88\" x2=\"230\" y2=\"88\" stroke=\"#fb923c\" stroke-width=\"1.6\"/><path d=\"M151.1,91.5 L145.0,88.0 L151.1,84.5\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"1.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><path d=\"M224.9,84.5 L231.0,88.0 L224.9,91.5\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"1.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"188.0\" y=\"83\" fill=\"#fb923c\" font-size=\"15\" font-weight=\"700\" text-anchor=\"middle\">T</text><line x1=\"272\" y1=\"20\" x2=\"344\" y2=\"20\" stroke=\"currentColor\" stroke-width=\"3\"/><line x1=\"278\" y1=\"20\" x2=\"286\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".5\"/><line x1=\"288\" y1=\"20\" x2=\"296\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".5\"/><line x1=\"298\" y1=\"20\" x2=\"306\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".5\"/><line x1=\"308\" y1=\"20\" x2=\"316\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".5\"/><line x1=\"318\" y1=\"20\" x2=\"326\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".5\"/><line x1=\"328\" y1=\"20\" x2=\"336\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".5\"/><line x1=\"338\" y1=\"20\" x2=\"346\" y2=\"12\" stroke=\"currentColor\" stroke-width=\"1.2\" opacity=\".5\"/><polyline points=\"308,20 308,30 316,36 300,47 316,58 300,69 316,80 300,91 316,103 300,114 316,125 300,136 316,147 300,158 308,164 308,174\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"290\" y=\"174\" width=\"36\" height=\"36\" rx=\"4\" fill=\"rgba(148,163,184,.35)\" stroke=\"currentColor\" stroke-width=\"2.5\"/><text x=\"308\" y=\"198.06267664155908\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"middle\">m</text><path d=\"M290,187 L284,192 L290,197 Z\" fill=\"currentColor\"/><text x=\"281\" y=\"178.06267664155908\" fill=\"#34d399\" font-size=\"14\" font-weight=\"700\" text-anchor=\"end\">bút</text><line x1=\"346\" y1=\"166\" x2=\"346\" y2=\"218\" stroke=\"#34d399\" stroke-width=\"2\"/><path d=\"M342.0,171.0 L346.0,164.1 L350.0,171.0\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><path d=\"M350.0,213.1 L346.0,220.1 L342.0,213.1\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"226\" y1=\"244\" x2=\"126\" y2=\"244\" stroke=\"#fb923c\" stroke-width=\"2.2\"/><path d=\"M132.7,249.0 L124.0,244.0 L132.7,239.0\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"2.2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"234\" y=\"249\" fill=\"#fb923c\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">giấy chạy đều</text></svg><figcaption>Hình 2. Bút gắn vào vật vẽ trên giấy chạy đều ra đường hình sin.<br>Trục đứng: li độ $x$, từ $-A$ đến $A$.<br>$T$: một chu kì.</figcaption></figure>\n<ol class=\"tl-fns\"><li id=\"tl-fn-h2\">Vẽ lại theo OpenStax, College Physics 2e, Hình 16.11 — CC BY‑NC‑SA 4.0 — openstax.org/books/college-physics-2e</li></ol>\n<ul>\n<li>$A$: giá trị lớn nhất của li độ.</li>\n<li>$T$: thời gian ngắn nhất để vật về chỗ cũ theo hướng cũ (đu ở Mở bài: $T = 3$ s).</li>\n</ul>\n<details class=\"tl-details tl-more\">\n<summary>Đoán thử: đồ thị là hình sin, sao phương trình lại dùng côsin?</summary>\n<p>Đường hình sin là tên chung cho đồ thị của cả hàm sin lẫn hàm côsin.</p>\n<p>Hai đồ thị chỉ lệch nhau theo trục thời gian.</p>\n</details>\n<div class=\"tl-box tl-keep tl-chot\">\n<p class=\"tl-label\">Chốt mục</p>\n<p class=\"tl-chot-h\">🎯 Cần nắm</p>\n<details class=\"tl-details tl-more\">\n<summary>Đồ thị li độ – thời gian có dạng gì?</summary>\n<p>Đường hình sin.</p>\n</details>\n<details class=\"tl-details tl-more tl-chot-ghi\">\n<summary>✍️ Tập ô 2·2 · đối chiếu 3 dòng</summary>\n<ul>\n<li>Đồ thị li độ – thời gian: đường <strong>hình sin</strong>; $x$ là vị trí so với VTCB, có thể âm.</li>\n<li>$A$: giá trị lớn nhất của li độ · $T$: thời gian ngắn nhất về chỗ cũ theo hướng cũ (cái đu: $T = 3$ s).</li>\n<li>$f = \\dfrac{1}{T}$: số dao động trong 1 s, đơn vị Hz.</li>\n</ul>\n</details>\n</div>\n\n<h4 data-tap=\"3.1\">4. Phương trình dao động điều hoà</h4>\n<p class=\"tl-claim\">Biên độ, tần số góc và pha ban đầu xác định dao động.</p>\n<p class=\"tl-meo\">🧠 <b>Biên – Tần – Pha</b></p>\n<p><strong>🔑 Hàm côsin · A biên độ · ω tần số góc · φ pha ban đầu</strong></p>\n<div class=\"tl-fx\">\n<p class=\"tl-fx-name\">Phương trình dao động điều hoà</p>\n<p>$$x=A\\cos(\\omega t+\\varphi)$$</p>\n<p>$$\\omega=\\dfrac{2\\pi}{T}$$</p>\n</div>\n<table class=\"tl-table\">\n<thead><tr><th>Ký hiệu</th><th>Tên</th><th>Ghi nhớ</th></tr></thead>\n<tbody>\n<tr><td>$x$</td><td>li độ</td><td>có thể âm; cm hoặc m</td></tr>\n<tr><td>$A$</td><td>biên độ</td><td>$A \\gt 0$, không đổi; cm hoặc m</td></tr>\n<tr><td>$\\omega$</td><td>tần số góc</td><td>đơn vị rad/s</td></tr>\n<tr><td>$\\omega t + \\varphi$</td><td>pha</td><td>cho biết vị trí và chiều chuyển động lúc $t$</td></tr>\n<tr><td>$\\varphi$</td><td>pha ban đầu</td><td>pha lúc $t = 0$ (rad)</td></tr>\n<tr><td>$T$</td><td>chu kì</td><td>thời gian một dao động (s)</td></tr>\n</tbody>\n</table>\n<p><strong>Ví dụ:</strong> $x = 5\\cos\\left(2\\pi t + \\dfrac{\\pi}{3}\\right)\\ \\text{cm}$ có $A = 5$ cm, $\\omega = 2\\pi$ rad/s, $\\varphi = \\dfrac{\\pi}{3}$ rad. Lúc $t = 0$: $x = 5\\cos\\dfrac{\\pi}{3} = 2{,}5$ cm.</p>\n<details class=\"tl-details tl-more\">\n<summary>Đoán thử: đổi $\\varphi$ thì đồ thị đổi thế nào?</summary>\n<p>Đồ thị giữ nguyên hình dạng, chỉ dịch sang trái hoặc phải.</p>\n<p>Tăng $\\varphi$ thì đồ thị dịch sang <strong>trái</strong>.</p>\n<p>Ví dụ: đồ thị ứng với $\\varphi = \\dfrac{\\pi}{2}$ lệch sang trái $\\dfrac{T}{4}$ so với đồ thị ứng với $\\varphi = 0$.</p>\n</details>\n<div class=\"tl-box tl-keep tl-chot\">\n<p class=\"tl-label\">Chốt mục</p>\n<p class=\"tl-chot-h\">🎯 Cần nắm</p>\n<details class=\"tl-details tl-more\">\n<summary>Viết phương trình dao động điều hoà, nêu tên từng ký hiệu.</summary>\n<p><strong>Biên – Tần – Pha.</strong> $x = A\\cos(\\omega t + \\varphi)$: $x$ li độ, $A$ biên độ, $\\omega$ tần số góc (rad/s), $\\omega t + \\varphi$ pha, $\\varphi$ pha ban đầu.</p>\n</details>\n<details class=\"tl-details tl-more tl-chot-ghi\">\n<summary>✍️ Tập ô 3·1 · đối chiếu 3 dòng</summary>\n<ul>\n<li>$x = A\\cos(\\omega t + \\varphi)$, $\\omega = \\dfrac{2\\pi}{T} = 2\\pi f$ (rad/s).</li>\n<li>$A \\gt 0$ (biên độ) · $\\omega t + \\varphi$: pha (rad) · $\\varphi$: pha lúc $t = 0$.</li>\n<li>Đổi $\\varphi$: đồ thị chỉ dịch ngang; tăng $\\varphi$ thì dịch sang trái.</li>\n</ul>\n</details>\n</div>\n\n<h4 data-tap=\"3.2-3\">5. Liên hệ với chuyển động tròn đều</h4>\n<p class=\"tl-claim\">Dao động điều hoà là hình chiếu của chuyển động tròn đều.</p>\n<p><strong>🔑 Hình chiếu · Quay đều · A = bán kính · ω = tốc độ góc</strong></p>\n<div class=\"tl-box tl-box--exp tl-note\" data-exp=\"tn-l11-daodongdieuhoa-03\">\n<p class=\"tl-label\">🔬 Ví dụ: cái bóng của van xe đạp</p>\n<ol class=\"tl-steps\">\n<li><strong>Làm:</strong> dựng bánh xe đạp thẳng đứng, quay đều. Chiếu đèn pin song song với mặt bánh xe để bóng van xe in lên tường.</li>\n<li><strong>Quan sát:</strong> van xe chạy vòng tròn, còn <strong>bóng của nó chạy qua lại</strong> theo một đường thẳng.</li>\n<li><strong>Rút ra:</strong> hình chiếu của chuyển động tròn đều lên một đường thẳng là <strong>dao động điều hoà</strong>.</li>\n</ol>\n</div>\n<!--video:tn-l11-daodongdieuhoa-03-->\n<div class=\"tl-box tl-box--video tl-box--khung\" data-khung=\"{&quot;id&quot;:&quot;tn-l11-daodongdieuhoa-03&quot;,&quot;ten&quot;:&quot;Bóng của van xe đạp trên màn&quot;,&quot;video&quot;:&quot;https://jgvbdbpvjdntdgzthumv.supabase.co/storage/v1/object/public/lesson-clips/clip/tn-l11-daodongdieuhoa-03-20261127.mp4&quot;,&quot;tong_giay&quot;:49.8,&quot;o&quot;:[{&quot;khoa&quot;:&quot;gia_thuyet&quot;,&quot;giay&quot;:0,&quot;chu&quot;:&quot;Bóng của van quay đều dao động điều hoà.&quot;,&quot;kiem&quot;:&quot;Bóng của van chạy nhanh, chậm ra sao?&quot;},{&quot;khoa&quot;:&quot;du_doan&quot;,&quot;giay&quot;:3.8,&quot;chu&quot;:&quot;Van quay đều, đèn chiếu song song. Bóng của van trên màn chạy nhanh, chậm thế nào?&quot;},{&quot;khoa&quot;:&quot;dung_cu&quot;,&quot;giay&quot;:10.1,&quot;chu&quot;:&quot;Bánh xe đạp quay đều, đèn pin, màn.&quot;},{&quot;khoa&quot;:&quot;quan_sat&quot;,&quot;giay&quot;:13,&quot;chu&quot;:&quot;Van chạy vòng tròn; bóng chạy qua lại, x = 10; −4,16; −6,54; 9,60 cm lúc t = 0; 1; 2; 3 s.&quot;},{&quot;khoa&quot;:&quot;rut_ra&quot;,&quot;giay&quot;:23.8,&quot;chu&quot;:&quot;Gần hai đầu chấm dày: bóng chậm. Bóng dao động điều hoà: A = bán kính, ω = tốc độ góc.&quot;},{&quot;khoa&quot;:&quot;chua_noi&quot;,&quot;giay&quot;:39.1,&quot;chu&quot;:&quot;Giả thiết bánh quay đều, đèn chiếu song song; số liệu minh hoạ, không đo thật.&quot;}],&quot;dung_dua&quot;:{&quot;giay&quot;:9.9,&quot;cau_hoi&quot;:&quot;Van quay đều, đèn chiếu song song. Bóng của van trên màn chạy nhanh, chậm thế nào?&quot;,&quot;chon&quot;:[&quot;A. Đều, như van xe&quot;,&quot;B. Nhanh ở giữa, chậm ở hai đầu&quot;,&quot;C. Chậm ở giữa, nhanh ở hai đầu&quot;,&quot;D. Nhanh dần từ đầu này sang đầu kia&quot;],&quot;dung&quot;:1,&quot;giai_thich_dung&quot;:&quot;Sau những khoảng thời gian bằng nhau, chấm của bóng dày ở hai đầu, thưa ở giữa: gần hai đầu bóng đi ít, tức là chậm.&quot;,&quot;giai_thich_sai&quot;:&quot;Van đi đều trên vòng tròn, nhưng gần hai đầu van chạy gần như song song với tia đèn nên bóng nhích rất ít; qua giữa, van chạy dọc màn nên bóng đi nhanh. Hai đầu giống nhau nên không có chuyện nhanh dần một chiều. Xem tiếp: chấm cách đều thời gian.&quot;},&quot;cau_chot&quot;:{&quot;giay&quot;:42.8,&quot;cau_hoi&quot;:&quot;Bánh xe bán kính R = 6 cm quay đều 1 vòng mỗi giây; đèn chiếu song song. Biên độ A và tần số góc ω của bóng van là:&quot;,&quot;chon&quot;:[&quot;A. 6 cm; 1 rad/s&quot;,&quot;B. 6 cm; 2π rad/s&quot;,&quot;C. 12 cm; 2π rad/s&quot;,&quot;D. 3 cm; π rad/s&quot;],&quot;dung&quot;:1,&quot;giai_thich&quot;:[&quot;1 vòng mỗi giây không phải 1 rad/s: một vòng là 2π rad, nên ω = 2π rad/s. Biên độ 6 cm thì đúng.&quot;,&quot;Biên độ bằng bán kính: A = 6 cm. Một vòng là 2π rad, quay 1 vòng mỗi giây nên ω = 2π rad/s (≈ 6,28 rad/s).&quot;,&quot;12 cm là cả đoạn bóng chạy (2A, từ đầu này sang đầu kia); biên độ chỉ bằng bán kính, 6 cm.&quot;,&quot;3 cm là nửa bán kính, π rad/s là nửa vòng mỗi giây. Biên độ = bán kính = 6 cm; ω = 2π rad/s.&quot;]},&quot;poster&quot;:&quot;https://jgvbdbpvjdntdgzthumv.supabase.co/storage/v1/object/public/lesson-clips/clip/tn-l11-daodongdieuhoa-03-20261127.webp&quot;}\">\n<p class=\"tl-label\">🎬 Xem thí nghiệm dựng lại · 49 giây</p>\n<p class=\"tl-video-ten\">Bóng của van xe đạp trên màn (minh hoạ)</p>\n<div class=\"tl-video tl-video--doc\"><video src=\"https://jgvbdbpvjdntdgzthumv.supabase.co/storage/v1/object/public/lesson-clips/clip/tn-l11-daodongdieuhoa-03-20261127.mp4\" poster=\"https://jgvbdbpvjdntdgzthumv.supabase.co/storage/v1/object/public/lesson-clips/clip/tn-l11-daodongdieuhoa-03-20261127.webp\" controls preload=\"none\" playsinline title=\"bóng của van xe đạp trên màn (minh hoạ)\" style=\"position:absolute;inset:0;width:100%;height:100%;background:#000\"></video></div>\n<p class=\"tl-video-goi-y\"><strong>Nhìn vào:</strong> Bóng chạy nhanh chậm thế nào dọc màn?</p>\n</div>\n\n<figure class=\"fig\" data-tl=\"1\"><svg viewBox=\"0 0 360 258\" role=\"img\" aria-label=\"Quả cầu M quay đều quanh O, đèn chiếu thẳng xuống; bóng Q của M trên trục Ox chạy qua lại giữa −A và A\"><text x=\"170\" y=\"18\" fill=\"#fb923c\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">đèn chiếu thẳng xuống</text><line x1=\"110\" y1=\"28\" x2=\"110\" y2=\"58\" stroke=\"#fb923c\" stroke-width=\"1.8\"/><path d=\"M114.0,53.1 L110.0,60.0 L106.0,53.1\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"1.8\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"150\" y1=\"28\" x2=\"150\" y2=\"58\" stroke=\"#fb923c\" stroke-width=\"1.8\"/><path d=\"M154.0,53.1 L150.0,60.0 L146.0,53.1\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"1.8\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"221\" y1=\"28\" x2=\"221\" y2=\"58\" stroke=\"#fb923c\" stroke-width=\"1.8\"/><path d=\"M225.0,53.1 L221.0,60.0 L217.0,53.1\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"1.8\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"270\" y1=\"28\" x2=\"270\" y2=\"58\" stroke=\"#fb923c\" stroke-width=\"1.8\"/><path d=\"M274.0,53.1 L270.0,60.0 L266.0,53.1\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"1.8\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><circle cx=\"170\" cy=\"170\" r=\"80\" fill=\"rgba(148,163,184,.12)\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"56\" y1=\"170\" x2=\"320\" y2=\"170\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M313.3,165.0 L322.0,170.0 L313.3,175.0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"322\" y=\"192\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"end\">x</text><line x1=\"93\" y1=\"170\" x2=\"247\" y2=\"170\" stroke=\"#38bdf8\" stroke-width=\"4\" opacity=\".55\"/><line x1=\"90\" y1=\"164\" x2=\"90\" y2=\"176\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"250\" y1=\"164\" x2=\"250\" y2=\"176\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"84\" y=\"162\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"end\">−A</text><text x=\"256\" y=\"162\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">A</text><circle cx=\"170\" cy=\"170\" r=\"3.5\" fill=\"currentColor\"/><text x=\"164\" y=\"190\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"end\">O</text><line x1=\"170\" y1=\"170\" x2=\"221.4\" y2=\"108.7\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"179.71150438746156\" y=\"133.35822227524088\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"middle\">A</text><path d=\"M198,170 A28,28 0 0 0 188.0,148.6\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"1.8\"/><text x=\"208.0649270555393\" y=\"158.25003300689062\" fill=\"#34d399\" font-size=\"16\" font-weight=\"700\" text-anchor=\"middle\">φ</text><path d=\"M198.4,82.5 A92,92 0 0 0 135.5,84.7\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2\"/><path d=\"M144.4,86.0 L135.5,84.7 L141.1,77.6\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"111.84393803904234\" y=\"87.78009245427566\" fill=\"#34d399\" font-size=\"16\" font-weight=\"700\" text-anchor=\"middle\">ω</text><line x1=\"221.4\" y1=\"116.7\" x2=\"221.4\" y2=\"164\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-dasharray=\"4 3\"/><circle cx=\"221.4\" cy=\"108.7\" r=\"8\" fill=\"#f87171\" stroke=\"currentColor\" stroke-width=\"1.5\"/><text x=\"233.42300877492315\" y=\"102.71644455048175\" fill=\"#f87171\" font-size=\"15\" font-weight=\"700\" text-anchor=\"start\">M</text><circle cx=\"221.4\" cy=\"170\" r=\"5.5\" fill=\"#38bdf8\"/><text x=\"227.42300877492315\" y=\"192\" fill=\"#38bdf8\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">Q (bóng)</text></svg><figcaption>Hình 3. Quả cầu $M$ quay đều, bóng $Q$ của nó trên trục $Ox$ chạy qua lại giữa $-A$ và $A$.<br>Ghi vị trí $Q$ lên giấy chạy đều sẽ được đường hình sin như Hình 2.</figcaption></figure>\n<ol class=\"tl-fns\"><li id=\"tl-fn-h3\">Vẽ lại theo OpenStax, College Physics 2e, Hình 16.18 — CC BY‑NC‑SA 4.0 — openstax.org/books/college-physics-2e</li></ol>\n<ul>\n<li>$M$ quay đều tốc độ góc $\\omega$, bán kính $OM = A$.</li>\n<li>Lúc $t = 0$, $OM$ hợp với trục $Ox$ góc $\\varphi$.</li>\n<li>Hình chiếu $Q$ của $M$ lên trục $Ox$: $x = A\\cos(\\omega t + \\varphi)$.</li>\n</ul>\n<details class=\"tl-details tl-more\">\n<summary>Đoán thử: $Q$ ở biên khi $M$ ở đâu?</summary>\n<p>Khi $M$ ở hai đầu đường kính nằm trên trục $Ox$.</p>\n<p>Từ biên này sang biên kia, $M$ quay nửa vòng, mất $\\dfrac{T}{2}$.</p>\n</details>\n\n<details class=\"tl-details tl-more\">\n<summary>🧪 Thử với mô phỏng: vật nặng treo lò xo</summary>\n<iframe src=\"https://phet.colorado.edu/sims/html/masses-and-springs/latest/masses-and-springs_all.html?locale=vi\" width=\"100%\" height=\"520\" style=\"border:1px solid #ddd;border-radius:8px;box-sizing:border-box;max-width:100%;display:block\" allowfullscreen loading=\"lazy\" title=\"Mô phỏng PhET: Con lắc lò xo\"></iframe>\n<p><strong>Thử:</strong></p>\n<ol class=\"tl-steps\">\n<li>Chọn màn hình <strong>Giới thiệu</strong>. Treo một quả cân vào lò xo, kéo xuống một đoạn rồi thả. Theo em, vật nặng hơn thì dao động nhanh hơn hay chậm hơn? Dự đoán trước.</li>\n<li>Đổi quả cân (50 g, 100 g, 250 g), mỗi lần kéo xuống cùng một đoạn. Dùng đồng hồ trong mô phỏng để đo thời gian một vài dao động.</li>\n<li>Đổi <strong>độ cứng</strong> của lò xo (trong mô phỏng gọi là hằng số lò xo) rồi thử lại. Rút ra: chu kì dao động phụ thuộc vào khối lượng và độ cứng lò xo thế nào?</li>\n</ol>\n<details class=\"tl-details tl-more\">\n<summary>Kết luận để đối chiếu</summary>\n<p>Vật nặng hơn thì chu kì dài hơn (dao động chậm hơn).</p>\n<p>Lò xo cứng hơn thì chu kì ngắn hơn (dao động nhanh hơn).</p>\n</details>\n<p><small>Mô phỏng: PhET Interactive Simulations, Đại học Colorado Boulder (CC BY 4.0).</small></p>\n</details>\n<div class=\"tl-box tl-keep tl-chot\">\n<p class=\"tl-label\">Chốt mục</p>\n<p class=\"tl-chot-h\">🎯 Cần nắm</p>\n<details class=\"tl-details tl-more\">\n<summary>Dao động điều hoà liên hệ thế nào với chuyển động tròn đều?</summary>\n<p>Là hình chiếu của chuyển động tròn đều: bán kính $= A$, tốc độ góc $= \\omega$.</p>\n</details>\n<details class=\"tl-details tl-more tl-chot-ghi\">\n<summary>✍️ Tập ô 3·2 · đối chiếu 3 dòng</summary>\n<ul>\n<li>$M$ quay đều tốc độ góc $\\omega$, bán kính $OM = A$; lúc $t = 0$, $OM$ hợp với $Ox$ góc $\\varphi$.</li>\n<li>Hình chiếu $Q$ của $M$ lên $Ox$: $x = A\\cos(\\omega t + \\varphi)$.</li>\n<li>Biên này sang biên kia: $M$ quay nửa vòng, mất $\\dfrac{T}{2}$.</li>\n</ul>\n</details>\n</div>\n\n<h3 data-tap=\"4.1\">III. Bẫy hay gặp</h3>\n<div class=\"tl-trap\">\n<h4>Bẫy: ba chỗ hay nhầm</h4>\n<table class=\"tl-table\">\n<thead><tr><th>Hay nhầm</th><th>Đúng</th></tr></thead>\n<tbody>\n<tr><td>Li độ $x$ là quãng đường đã đi</td><td>$x$ là vị trí so với VTCB, có thể âm</td></tr>\n<tr><td>Biên độ có thể âm</td><td>$A \\gt 0$; dấu trừ nằm ở pha</td></tr>\n<tr><td>Hết một chu kì thì $x$ bằng 0</td><td>hết một chu kì vật về đúng vị trí cũ, theo chiều cũ</td></tr>\n</tbody>\n</table>\n</div>\n<div class=\"tl-box tl-box--think tl-check\">\n<p class=\"tl-label\">Tự kiểm tra 1</p>\n<p>Vật dao động theo $x = 4\\cos(\\pi t)\\ \\text{cm}$. Khi vật ở biên phía âm, li độ bằng:</p>\n<div class=\"tl-quiz\">\n<input type=\"radio\" name=\"tl1-q1\" id=\"tl1-q1a\"><label for=\"tl1-q1a\" class=\"tl-opt tl-no\">A. $4$ cm</label>\n<input type=\"radio\" name=\"tl1-q1\" id=\"tl1-q1c\"><label for=\"tl1-q1c\" class=\"tl-opt tl-no\">B. $0$</label>\n<input type=\"radio\" name=\"tl1-q1\" id=\"tl1-q1d\"><label for=\"tl1-q1d\" class=\"tl-opt tl-no\">C. $8$ cm</label>\n<input type=\"radio\" name=\"tl1-q1\" id=\"tl1-q1b\"><label for=\"tl1-q1b\" class=\"tl-opt tl-ok\">D. $-4$ cm</label>\n<div class=\"tl-fb tl-fb--ok\"><p><strong>Đúng.</strong> Li độ là vị trí so với VTCB: biên phía âm có $x = -A = -4$ cm.</p></div>\n<div class=\"tl-fb tl-fb--no\"><p><strong>Chưa đúng.</strong> Li độ có dấu. Biên phía âm nằm ở bên nào của VTCB, cách bao xa?</p></div>\n</div>\n</div>\n<div class=\"tl-box tl-box--think tl-check\">\n<p class=\"tl-label\">Tự kiểm tra 2</p>\n<p>Biên độ của dao động $x = -3\\cos(2t)\\ \\text{cm}$ là:</p>\n<div class=\"tl-quiz\">\n<input type=\"radio\" name=\"tl1-q2\" id=\"tl1-q2a\"><label for=\"tl1-q2a\" class=\"tl-opt tl-no\">A. $-3$ cm</label>\n<input type=\"radio\" name=\"tl1-q2\" id=\"tl1-q2b\"><label for=\"tl1-q2b\" class=\"tl-opt tl-ok\">B. $3$ cm</label>\n<input type=\"radio\" name=\"tl1-q2\" id=\"tl1-q2c\"><label for=\"tl1-q2c\" class=\"tl-opt tl-no\">C. $6$ cm</label>\n<input type=\"radio\" name=\"tl1-q2\" id=\"tl1-q2d\"><label for=\"tl1-q2d\" class=\"tl-opt tl-no\">D. $2$ cm</label>\n<div class=\"tl-fb tl-fb--ok\"><p><strong>Đúng.</strong> Biên độ luôn dương. Dấu trừ có thể viết lại thành pha: $-\\cos\\alpha = \\cos(\\alpha + \\pi)$.</p></div>\n<div class=\"tl-fb tl-fb--no\"><p><strong>Chưa đúng.</strong> Biên độ là giá trị lớn nhất của li độ, nên nó có thể âm không? Đưa dấu trừ vào pha ($-\\cos\\alpha = \\cos(\\alpha + \\pi)$) rồi mới đọc $A$.</p></div>\n</div>\n</div>\n\n<h3 data-tap=\"4.2\">IV. Trả bài</h3>\n<div class=\"tl-box tl-box--think tl-check\">\n<p class=\"tl-label\">Trả bài</p>\n<p>Gấp bài lại, trả lời 5 câu 🎯 của năm ô Chốt mục ở trên vào Tập ô 4·2; câu nào vướng thì mở lại ô đó.</p>\n</div>\n\n<h3 data-tap=\"5.2\">V. Bài toán mẫu</h3>\n<div class=\"tl-box tl-box--rule tl-note\">\n<p class=\"tl-label\">📝 Đề bài</p>\n<p>Một vật dao động điều hoà theo phương trình $x = 6\\cos\\left(5\\pi t + \\dfrac{\\pi}{2}\\right)\\ \\text{cm}$ ($t$ tính bằng giây). Xác định biên độ, tần số góc, pha ban đầu và li độ của vật lúc $t = 0$ và lúc $t = 0{,}1$ s.</p>\n</div>\n<div class=\"table-scroll\"><table class=\"tl-table tl-table--data\">\n<thead><tr><th>Câu trong đề</th><th>Dữ liệu</th><th>Kiến thức liên quan</th></tr></thead>\n<tbody>\n<tr><td>\"dao động điều hoà theo phương trình $x = 6\\cos(5\\pi t + \\pi/2)$\"</td><td>$A = 6$ cm, $\\omega = 5\\pi$ rad/s, $\\varphi = \\pi/2$ rad</td><td>đối chiếu với $x = A\\cos(\\omega t + \\varphi)$</td></tr>\n<tr><td>\"li độ lúc $t = 0$\"</td><td>$t = 0$</td><td>pha lúc đầu chính là $\\varphi$</td></tr>\n<tr><td>\"li độ lúc $t = 0{,}1$ s\"</td><td>$t = 0{,}1$ s</td><td>thay $t$ vào phương trình</td></tr>\n<tr><td>ngầm: góc tính bằng rad</td><td>máy tính ở chế độ radian</td><td>$\\omega$, $\\varphi$ đo bằng rad</td></tr>\n</tbody>\n</table></div>\n<div class=\"tl-box tl-box--think tl-check\">\n<p class=\"tl-label\">✍️ Tự giải trước, rồi so đáp số</p>\n<p>Viết lời giải ra nháp theo bảng trên, mỗi câu một dòng công thức.</p>\n<details class=\"tl-details tl-more\">\n<summary>💡 Gợi ý bước đầu</summary>\n<p>Đặt phương trình cạnh dạng chuẩn $x = A\\cos(\\omega t + \\varphi)$ để đọc ra $A$, $\\omega$, $\\varphi$, rồi để máy tính ở chế độ radian trước khi thay từng giá trị $t$ vào.</p>\n</details>\n<details class=\"tl-details tl-more\">\n<summary>Bấm xem đáp số</summary>\n<p>$A = 6$ cm; $\\omega = 5\\pi$ rad/s; $\\varphi = \\dfrac{\\pi}{2}$ rad.</p>\n<p>Lúc $t = 0$: $x = 0$ (vật ở VTCB).</p>\n<p>Lúc $t = 0{,}1$ s: pha bằng $\\pi$, $x = -6$ cm (biên âm).</p>\n<p>Tự kiểm: $|x|$ không bao giờ vượt $A = 6$ cm; máy tính phải để chế độ radian.</p>\n</details>\n<p>Sai hoặc bí ở câu nào → xem giải từng bước cùng kiểu ở Bài mẫu: <a href=\"#muc=bai-tap-mau&amp;dang=1\">Dạng 1</a> (cả bài).</p>\n</div>\n<div class=\"tl-box tl-box--think tl-check\">\n<p class=\"tl-label\">💪 Thử sức</p>\n<p>Vật dao động theo $x = 10\\cos(2\\pi t)\\ \\text{cm}$. Lúc $t = 0{,}25$ s, li độ bằng:</p>\n<div class=\"tl-quiz\">\n<input type=\"radio\" name=\"tl1-q3\" id=\"tl1-q3a\"><label for=\"tl1-q3a\" class=\"tl-opt tl-no\">A. $10$ cm</label>\n<input type=\"radio\" name=\"tl1-q3\" id=\"tl1-q3b\"><label for=\"tl1-q3b\" class=\"tl-opt tl-no\">B. $-10$ cm</label>\n<input type=\"radio\" name=\"tl1-q3\" id=\"tl1-q3c\"><label for=\"tl1-q3c\" class=\"tl-opt tl-ok\">C. $0$</label>\n<input type=\"radio\" name=\"tl1-q3\" id=\"tl1-q3d\"><label for=\"tl1-q3d\" class=\"tl-opt tl-no\">D. $5$ cm</label>\n<div class=\"tl-fb tl-fb--ok\"><p><strong>Đúng.</strong> Pha $= 2\\pi \\cdot 0{,}25 = \\dfrac{\\pi}{2}$, nên $x = 10\\cos\\dfrac{\\pi}{2} = 0$.</p></div>\n<div class=\"tl-fb tl-fb--no\"><p><strong>Chưa đúng.</strong> Tính pha $2\\pi t$ lúc $t = 0{,}25$ s trước (đơn vị rad), rồi mới lấy côsin.</p></div>\n</div>\n</div>\n\n<h3 data-tap=\"5.4\">VI. Đời sống và tổng kết</h3>\n<ul>\n<li><strong>Con lắc đồng hồ:</strong> dao động tuần hoàn, lặp đều để đếm giờ.</li>\n<li><strong>Dây đàn ghi-ta:</strong> dao động nhanh, cho ta nghe âm.</li>\n<li><strong>Pít-tông động cơ:</strong> chạy lên xuống nhờ trục khuỷu quay (trục có tay quay mà đầu tay quay chạy vòng tròn), nên gần giống cái bóng của van xe<sup class=\"tl-fn\"><a href=\"#tl-fn-1\">1</a></sup>.</li>\n</ul>\n<p>⚠ Đi từ biên này sang biên kia chưa phải trọn một chu kì.</p>\n<details class=\"tl-details tl-more\">\n<summary>🧩 Thử thách</summary>\n<p>Điểm $M$ quay đều một vòng hết 2 s, bán kính $A = 10$ cm. Hình chiếu $Q$ mất bao lâu để đi từ biên này sang biên kia?</p>\n<p><strong>1 s</strong>: từ biên này sang biên kia ứng với $M$ quay nửa vòng.</p>\n</details>\n<div class=\"tl-box tl-box--rule tl-keep\">\n<p class=\"tl-label\">🎒 Mang về sau bài học</p>\n<p>Ruột tập: điền đủ các ô <strong>1·4, 2·1, 2·2, 3·1, 3·2</strong>. Ô nào còn trống, mở dòng ✍️ trong ô Chốt mục tương ứng ở trên.</p>\n</div>\n<ol class=\"tl-fns\">\n<li id=\"tl-fn-1\">Chỉ gần đúng: thanh nối pít-tông với trục khuỷu có độ dài hữu hạn nên chuyển động pít-tông không điều hoà hoàn toàn.</li>\n</ol>\n","summary_html":"<ul>\n<li>Dao động cơ: vật chuyển động qua lại quanh một vị trí cân bằng.</li>\n<li>Dao động tuần hoàn: sau những khoảng thời gian bằng nhau, vật trở lại vị trí cũ theo hướng cũ.</li>\n<li>Dao động điều hoà: dao động tuần hoàn đơn giản nhất, mô tả bằng phương trình $x = A\\cos(\\omega t + \\varphi)$</li>\n<li>Li độ $x$: vị trí của vật tại thời điểm t, đo từ vị trí cân bằng.</li>\n<li>Biên độ $A$: giá trị lớn nhất của li độ, không đổi trong quá trình dao động.</li>\n<li>Tần số góc $\\omega$: đại lượng đặc trưng cho tốc độ dao động, đơn vị rad/s.</li>\n<li>Pha dao động $(\\omega t + \\varphi)$: xác định trạng thái dao động ở thời điểm t.</li>\n<li>Pha ban đầu $\\varphi$: pha tại $t = 0$, xác định điều kiện ban đầu.</li>\n<li>Dao động điều hoà là hình chiếu của chuyển động tròn đều lên một đường kính, với tốc độ góc bằng $\\omega$ và bán kính bằng $A$.</li>\n</ul>","questions":[],"questions_count":0},{"id":3,"lesson_id":20,"kind":"bai_tap_mau","title":"Bài tập mẫu","subtitle":"5 dạng bài kèm lời giải","video_url":"","pdf_url":"","exam_ids":[],"sort_order":3,"due_at":null,"required":true,"quiz_min_correct":null,"practice_pass_score":null,"published_at":"2026-09-26T10:28:01.899319+00:00","body_html":"","summary_html":"","questions":[],"questions_count":5},{"id":4,"lesson_id":20,"kind":"luyen_tap","title":"Luyện tập sách","subtitle":"89 câu (62 TN · 9 ĐS · 18 TLN) — 30 phút","video_url":"","pdf_url":"","exam_ids":[43],"sort_order":4,"due_at":null,"required":true,"quiz_min_correct":null,"practice_pass_score":null,"published_at":"2026-09-26T10:28:01.899319+00:00","body_html":"","summary_html":"","questions":[],"questions_count":0},{"id":5,"lesson_id":20,"kind":"luyen_tap","title":"Bài 1: Dao động điều hòa","subtitle":"","video_url":"","pdf_url":"","exam_ids":[],"sort_order":5,"due_at":null,"required":true,"quiz_min_correct":null,"practice_pass_score":null,"published_at":"2026-09-26T10:28:01.899319+00:00","body_html":"","summary_html":"","questions":[],"questions_count":0},{"id":6,"lesson_id":20,"kind":"kiem_tra","title":"Kiểm tra cuối bài - Tuần 3","subtitle":"","video_url":"","pdf_url":"","exam_ids":[],"sort_order":6,"due_at":null,"required":true,"quiz_min_correct":null,"practice_pass_score":null,"published_at":"2026-09-26T10:28:01.899319+00:00","body_html":"","summary_html":"","questions":[],"questions_count":0}]}