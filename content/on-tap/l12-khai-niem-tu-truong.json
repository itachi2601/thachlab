\" y1=\"168.0\" x2=\"208.8\" y2=\"213.2\" stroke=\"#f87171\" stroke-width=\"10\"/><text x=\"175\" y=\"129\" fill=\"#38bdf8\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">S</text><text x=\"225\" y=\"219\" fill=\"#f87171\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">N</text><text x=\"14\" y=\"24\" fill=\"#38bdf8\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">S: cực từ nam</text><text x=\"14\" y=\"322\" fill=\"#f87171\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">N: cực từ bắc</text><polygon points=\"343.8,115.6 356.3,137.6 340.6,140.7\" fill=\"#f87171\"/><polygon points=\"353.0,162.7 356.3,137.6 340.6,140.7\" fill=\"#38bdf8\"/><circle cx=\"348.4\" cy=\"139.1\" r=\"2.5\" fill=\"currentColor\"/><circle cx=\"348.4\" cy=\"139.1\" r=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" opacity=\".6\"/><text x=\"426\" y=\"24\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"end\">kim la bàn</text><text x=\"426\" y=\"42\" fill=\"#34d399\" font-size=\"14\" font-weight=\"600\" text-anchor=\"end\">nằm theo đường sức</text></svg></figure>"
