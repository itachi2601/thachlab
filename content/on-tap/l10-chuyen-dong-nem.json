 x2=\"45\" y2=\"58.6\" stroke=\"currentColor\" stroke-width=\"1.4\" opacity=\"1\"/><line x1=\"35\" y1=\"78.4\" x2=\"45\" y2=\"78.4\" stroke=\"currentColor\" stroke-width=\"1.4\" opacity=\"1\"/><line x1=\"35\" y1=\"111.4\" x2=\"45\" y2=\"111.4\" stroke=\"currentColor\" stroke-width=\"1.4\" opacity=\"1\"/><line x1=\"35\" y1=\"157.60000000000002\" x2=\"45\" y2=\"157.60000000000002\" stroke=\"currentColor\" stroke-width=\"1.4\" opacity=\"1\"/><line x1=\"35\" y1=\"217.0\" x2=\"45\" y2=\"217.0\" stroke=\"currentColor\" stroke-width=\"1.4\" opacity=\"1\"/><text x=\"140\" y=\"18\" fill=\"currentColor\" font-size=\"14\" font-weight=\"400\" text-anchor=\"start\">Ox: mỗi khoảng thời gian bằng nhau</text><text x=\"140\" y=\"36\" fill=\"currentColor\" font-size=\"14\" font-weight=\"400\" text-anchor=\"start\">→ đoạn ngang bằng nhau</text><text x=\"20\" y=\"258\" fill=\"currentColor\" font-size=\"14\" font-weight=\"400\" text-anchor=\"start\">Oy: các đoạn rơi tăng theo tỉ lệ 1 : 3 : 5 : 7 : 9</text><text x=\"20\" y=\"277\" fill=\"#34d399\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">→ quỹ đạo là một phần parabol</text></svg></figure>"
