002\" x2=\"370.0\" y2=\"197.95000000000002\" stroke=\"currentColor\" stroke-width=\"1.1\" stroke-dasharray=\"4 4\" opacity=\"0.35\"/><text x=\"211.0\" y=\"61.537499999999994\" fill=\"#38bdf8\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">v<tspan dy=\"4\" font-size=\"14\">x</tspan></text><text x=\"123.0\" y=\"93.4375\" fill=\"#fb923c\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">v<tspan dy=\"4\" font-size=\"14\">y</tspan></text><text x=\"376.0\" y=\"199.95000000000002\" fill=\"#f87171\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">v</text><text x=\"20\" y=\"226\" fill=\"#38bdf8\" font-size=\"14\" font-weight=\"400\" text-anchor=\"start\">Thành phần ngang không đổi</text><text x=\"20\" y=\"245\" fill=\"#fb923c\" font-size=\"14\" font-weight=\"400\" text-anchor=\"start\">Thành phần đứng lớn dần</text><text x=\"20\" y=\"264\" fill=\"#f87171\" font-size=\"14\" font-weight=\"400\" text-anchor=\"start\">v là tổng hai vectơ vuông góc</text></svg></figure>"
