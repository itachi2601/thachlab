\" stroke-linecap=\"butt\"/><text x=\"268.0\" y=\"246.0\" fill=\"#34d399\" font-size=\"16\" font-weight=\"700\" text-anchor=\"end\" font-style=\"italic\" font-family=\"serif\">a</text><text x=\"30.0\" y=\"22.0\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"start\">Bàn nhẵn</text><text x=\"30.0\" y=\"42.0\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"start\">Dây nhẹ, không dãn</text></svg></figure>"
