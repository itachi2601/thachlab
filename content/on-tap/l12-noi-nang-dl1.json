   "tieu_muc": "4. Định luật I Nhiệt động lực học",
   "hinh": "<figure class=\"fig\" data-tl=\"1\"><svg viewBox=\"0 0 440 316\" role=\"img\" aria-label=\"Sơ đồ định luật I cho một lần ấn bơm: công 60 J truyền vào khí, khí toả ra 15 J, độ biến thiên nội năng bằng 45 J\"><defs><marker id=\"f4-r\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#f87171\"/></marker><marker id=\"f4-b\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#38bdf8\"/></marker><marker id=\"f4-o\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#fb923c\"/></marker><marker id=\"f4-g\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#34d399\"/></marker></defs><text x=\"16\" y=\"24\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"start\">Định luật I cho một lần ấn bơm</text><rect x=\"120\" y=\"100\" width=\"84\" height=\"116\" rx=\"8\" fill=\"rgba(56,189,248,.12)\" stroke=\"currentColor\" stroke-width=\"2.5\"/><circle cx=\"136\" cy=\"140\" r=\"3.4\" fill=\"#38bdf8\"/><circle cx=\"162\" cy=\"140\" r=\"3.4\" fill=\"#38bdf8\"/><circle cx=\"188\" cy=\"140\" r=\"3.4\" fill=\"#38bdf8\"/><circle cx=\"136\" cy=\"176\" r=\"3.4\" fill=\"#38bdf8\"/><circle cx=\"162\" cy=\"176\" r=\"3.4\" fill=\"#38bdf8\"/><circle cx=\"188\" cy=\"176\" r=\"3.4\" fill=\"#38bdf8\"/><rect x=\"112\" y=\"84\" width=\"100\" height=\"15\" rx=\"4\" fill=\"rgba(148,163,184,.35)\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"162\" y1=\"40\" x2=\"162\" y2=\"82\" stroke=\"#f87171\" stroke-width=\"2.8\"/><path d=\"M167.8,72.0 L162.0,82.0 L156.2,72.0\" fill=\"none\" stroke=\"#f87171\" stroke-width=\"2.8\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"176\" y=\"54\" fill=\"#f87171\" font-size=\"15\" font-weight=\"700\" text-anchor=\"start\">công 60 J</text><text x=\"176\" y=\"74\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"start\">tay truyền cho khí</text><text x=\"162\" y=\"240\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">khối khí</text><line x1=\"208\" y1=\"150\" x2=\"276\" y2=\"128\" stroke=\"#38bdf8\" stroke-width=\"2.8\"/><path d=\"M264.7,125.6 L276.0,128.0 L268.3,136.6\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.8\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"284\" y=\"116\" fill=\"#38bdf8\" font-size=\"15\" font-weight=\"700\" text-anchor=\"start\">toả ra 15 J</text><text x=\"284\" y=\"136\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"start\">qua thành ống</text><rect x=\"284\" y=\"156\" width=\"144\" height=\"86\" rx=\"8\" fill=\"rgba(52,211,153,.14)\" stroke=\"#34d399\" stroke-width=\"2.5\"/><text x=\"356\" y=\"182\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" text-anchor=\"middle\">ΔU = A + Q</text><text x=\"356\" y=\"206\" fill=\"currentColor\" font-size=\"15\" font-weight=\"600\" text-anchor=\"middle\">= 60 + (−15)</text><text x=\"356\" y=\"231\" fill=\"#34d399\" font-size=\"16\" font-weight=\"700\" text-anchor=\"middle\">= +45 J</text><line x1=\"16\" y1=\"262\" x2=\"424\" y2=\"262\" stroke=\"currentColor\" stroke-width=\"1.5\" opacity=\"0.5\"/><text x=\"16\" y=\"284\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"start\">Nhận vào thì dương: công +60 J</text><text x=\"16\" y=\"304\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"start\">Mất đi thì âm: nhiệt −15 J</text></svg></figure>"
