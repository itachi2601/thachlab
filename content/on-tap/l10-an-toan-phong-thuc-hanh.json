nchor=\"middle\">6</text><text x=\"306.0\" y=\"140.6\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">9</text><text x=\"327.0\" y=\"177.0\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">12</text><text x=\"285.0\" y=\"226.0\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">núm chọn vạch</text><circle cx=\"372\" cy=\"128\" r=\"13\" fill=\"#f87171\" stroke=\"currentColor\" stroke-width=\"1.5\"/><circle cx=\"372\" cy=\"186\" r=\"13\" fill=\"#38bdf8\" stroke=\"currentColor\" stroke-width=\"1.5\"/><text x=\"372\" y=\"135\" fill=\"#1f2937\" font-size=\"20\" font-weight=\"700\" text-anchor=\"middle\">+</text><text x=\"372\" y=\"193\" fill=\"#1f2937\" font-size=\"20\" font-weight=\"700\" text-anchor=\"middle\">−</text><text x=\"372.0\" y=\"163.0\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">đỏ</text><text x=\"372.0\" y=\"216.0\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">xanh</text></svg></figure>"
