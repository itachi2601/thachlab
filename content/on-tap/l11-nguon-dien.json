 cy=\"85\" r=\"4.5\" fill=\"#34d399\" stroke=\"currentColor\" stroke-width=\"1\"/><circle cx=\"169.375\" cy=\"112.5\" r=\"4.5\" fill=\"#34d399\" stroke=\"currentColor\" stroke-width=\"1\"/><circle cx=\"191.25\" cy=\"126.25\" r=\"4.5\" fill=\"#34d399\" stroke=\"currentColor\" stroke-width=\"1\"/><circle cx=\"60\" cy=\"43.75\" r=\"4\" fill=\"#f87171\"/><circle cx=\"388.125\" cy=\"250\" r=\"4\" fill=\"#f87171\"/><text x=\"68\" y=\"33\" fill=\"#f87171\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\"><tspan font-style=\"italic\" font-family=\"Georgia,'Times New Roman',serif\" font-size=\"1.1em\">E</tspan> = 1,50 V</text><text x=\"428\" y=\"210\" fill=\"#f87171\" font-size=\"14\" font-weight=\"700\" text-anchor=\"end\">đoản mạch</text><text x=\"428\" y=\"227\" fill=\"#f87171\" font-size=\"14\" font-weight=\"700\" text-anchor=\"end\">1,5 A</text><text x=\"136\" y=\"52\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\">Δ<tspan font-style=\"italic\" font-family=\"Georgia,'Times New Roman',serif\" font-size=\"1.1em\">I</tspan> = 0,50 A</text><text x=\"197\" y=\"95\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"start\">Δ<tspan font-style=\"italic\" font-family=\"Georgia,'Times New Roman',serif\" font-size=\"1.1em\">U</tspan> = −0,50 V</text><text x=\"197\" y=\"113\" fill=\"#34d399\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">độ dốc = −<tspan font-style=\"italic\" font-family=\"Georgia,'Times New Roman',serif\" font-size=\"1.1em\">r</tspan> = −1,0 Ω</text></svg></figure>"
