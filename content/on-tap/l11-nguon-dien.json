iddle\">electron</text><line x1=\"92\" y1=\"96\" x2=\"135\" y2=\"96\" stroke=\"#f87171\" stroke-width=\"2.5\"/><path d=\"M125.5,90.5 L135.0,96.0 L125.5,101.5\" fill=\"none\" stroke=\"#f87171\" stroke-width=\"2.5\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"113\" y=\"114\" fill=\"#f87171\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\"><tspan font-style=\"italic\" font-family=\"Georgia,'Times New Roman',serif\" font-size=\"1.1em\">I</tspan></text><text x=\"112\" y=\"150\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\"><tspan font-style=\"italic\" font-family=\"Georgia,'Times New Roman',serif\" font-size=\"1.1em\">V</tspan><tspan baseline-shift=\"sub\" font-size=\"14\">A</tspan> &gt; <tspan font-style=\"italic\" font-family=\"Georgia,'Times New Roman',serif\" font-size=\"1.1em\">V</tspan><tspan baseline-shift=\"sub\" font-size=\"14\">B</tspan>: có dòng</text><circle cx=\"275\" cy=\"80\" r=\"22\" fill=\"rgba(148,163,184,.15)\" stroke=\"currentColor\" stroke-width=\"2\" opacity=\"1\"/><text x=\"275\" y=\"85\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">A</text><text x=\"275\" y=\"48\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">0</text><circle cx=\"380\" cy=\"80\" r=\"22\" fill=\"rgba(148,163,184,.15)\" stroke=\"currentColor\" stroke-width=\"2\" opacity=\"1\"/><text x=\"380\" y=\"85\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">B</text><text x=\"380\" y=\"48\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">0</text><line x1=\"297\" y1=\"80\" x2=\"358\" y2=\"80\" stroke=\"currentColor\" stroke-width=\"2\" opacity=\"1\"/><text x=\"327\" y=\"150\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"middle\"><tspan font-style=\"italic\" font-family=\"Georgia,'Times New Roman',serif\" font-size=\"1.1em\">V</tspan><tspan