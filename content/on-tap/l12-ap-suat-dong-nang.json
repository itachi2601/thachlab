 "the": [
  {
   "id": "b82c48d9",
   "kieu": "lat",
   "muc": "II. Kiến thức",
   "neo": "Mô hình động học phân tử nói gì, và vì sao có áp suất?",
   "hoi": "Mô hình động học phân tử nói gì, và vì sao có áp suất?",
   "dap": "<ul><li><strong>Nhỏ – Loạn – Đập – Nảy.</strong> Nhỏ: phân tử bé xíu so với khoảng cách</li><li>Loạn: hỗn loạn không ngừng</li><li>Đập: va vào thành gây áp suất</li><li>Nảy: va chạm đàn hồi, bật ngược</li><li>Giữa hai va chạm, phân tử bay thẳng đều</li><li>Mỗi va chạm, phân tử truyền động lượng cho thành rồi bật ngược; vô số va chạm mỗi giây cộng thành lực đẩy đều lên thành — đó là áp suất</li></ul>",
   "tieu_muc": "1. Mô hình khí lí tưởng nhìn từ thành bình"
  },
  {
   "id": "2475cc41",
   "kieu": "lat",
   "muc": "II. Kiến thức",
   "neo": "Vì sao độ biến thiên động lượng khi va chạm vuông góc với th",
   "hoi": "Vì sao độ biến thiên động lượng khi va chạm vuông góc với thành là $2mv$?",
   "dap": "<ul><li><strong>Động lượng là vectơ.</strong> Phân tử đổi chiều: từ $+mv$ thành $-mv$</li><li>Hiệu hai vectơ có độ lớn $\\left|-mv - (+mv)\\right| = 2mv$</li><li>Nếu chỉ nhìn \"tốc độ không đổi\" thì dễ kết luận sai là $0$</li></ul>",
   "tieu_muc": "2. Một phân tử va chạm vào thành bình",
   "hinh": "<figure class=\"fig\" data-tl=\"1\"><svg viewBox=\"0 0 420 224\" role=\"img\" aria-label=\"Phân tử khối lượng m bay song song trục Ox với tốc độ v, đập vào thành bình rồi bật ngược lại với cùng tốc độ\"><defs><marker id=\"f2-r\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#f87171\"/></marker><marker id=\"f2-b\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#38bdf8\"/></marker><marker id=\"f2-o\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#fb923c\"/></marker><marker id=\"f2-g\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#34d399\"/></marker></defs><text x=\"14\" y=\"20\" fill=\"currentColor\" font-size=\"12\" font-weight=\"700\" text-anchor=\"start\">Một phân tử đập vuông góc vào thành bình</text><line x1=\"50\" y1=\"38\" x2=\"350\" y2=\"38\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-dasharray=\"5 4\" opacity=\"0.8\"/><line x1=\"50\" y1=\"33\" x2=\"50\" y2=\"43\" stroke=\"currentColor\" stroke-width=\"1.6\" opacity=\"1\"/><line x1=\"350\" y1=\"33\" x2=\"350\" y2=\"43\" stroke=\"currentColor\" stroke-width=\"1.6\" opacity=\"1\"/><text x=\"356\" y=\"42\" fill=\"currentColor\" font-size=\"11\" font-weight=\"600\" text-anchor=\"start\">cạnh l</text><text x=\"14\" y=\"190\" fill=\"currentColor\" font-size=\"11\" font-weight=\"600\" text-anchor=\"start\">V = l³</text><rect x=\"50\" y=\"50\" width=\"300\" height=\"120\" rx=\"8\" fill=\"rgba(148,163,184,.06)\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"350\" y1=\"50\" x2=\"350\" y2=\"170\" stroke=\"#f87171\" stroke-width=\"3.5\" opacity=\"1\"/><line x1=\"30\" y1=\"110\" x2=\"404\" y2=\"110\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-dasharray=\"6 5\" opacity=\"0.5\"/><text x=\"404\" y=\"108\" fill=\"currentColor\" font-size=\"11\" font-weight=\"600\" text-anchor=\"end\">Ox</text><circle cx=\"95\" cy=\"110\" r=\"6\" fill=\"#38bdf8\"/><line x1=\"112\" y1=\"110\" x2=\"338\" y2=\"110\" stroke=\"#38bdf8\" stroke-width=\"2.8\"/><path d=\"M328.0,104.2 L338.0,110.0 L328.0,115.8\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.8\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"210\" y=\"100\" fill=\"#38bdf8\" font-size=\"11\" font-weight=\"700\" text-anchor=\"middle\">tới: v, p = +mv</text><line x1=\"338\" y1=\"142\" x2=\"120\" y2=\"142\" stroke=\"#34d399\" stroke-width=\"2.8\"/><path d=\"M130.0,147.8 L120.0,142.0 L130.0,136.2\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2.8\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"232\" y=\"160\" fill=\"#34d399\" font-size=\"11\" font-weight=\"700\" text-anchor=\"middle\">bật ra: v, p = -mv</text><text x=\"350\" y=\"190\" fill=\"#f87171\" font-size=\"11\" font-weight=\"700\" text-anchor=\"end\">thành bình, diện tích S = l²</text><text x=\"210\" y=\"214\" fill=\"#fb923c\" font-size=\"12\" font-weight=\"700\" text-anchor=\"middle\">Độ biến thiên động lượng: 2mv</text></svg></figure>"
  },
  {
   "id": "f3a2526f",
   "kieu": "lat",
   "muc": "II. Kiến thức",
   "neo": "Viết công thức áp suất do một phân tử và do $N$ phân tử; nêu",
   "hoi": "Viết công thức áp suất do một phân tử và do $N$ phân tử; nêu tên, đơn vị các ký hiệu.",
   "dap": "<ul><li><strong>Một phân tử:</strong> $p_m = \\dfrac{m}{V}v^2$</li><li><strong>$N$ phân tử:</strong> $p = \\dfrac{1}{3}\\dfrac{Nm}{V}\\overline{v^2} = \\dfrac{1}{3}\\rho\\overline{v^2} = \\dfrac{2}{3}\\mu\\overline{E_d}$. Ở đây $m$ (kg) là khối lượng một phân tử, $V$ (m³) thể tích bình, $\\overline{v^2}$ (m²/s²) trung bình bình phương tốc độ, $\\mu = \\dfrac{N}{V}$ (1/m³) mật độ phân tử, $\\rho = \\mu m$ (kg/m³) khối lượng riêng, $\\overline{E_d}$ (J) động năng tịnh tiến trung bình</li></ul>",
   "tieu_muc": "3.",
   "hinh": "<figure class=\"fig\" data-tl=\"1\"><svg viewBox=\"0 0 420 214\" role=\"img\" aria-label=\"Ba phân tử có tốc độ khác nhau, bình phương các tốc độ rồi lấy trung bình thành tốc độ trung bình bình phương\"><defs><marker id=\"f3-r\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#f87171\"/></marker><marker id=\"f3-b\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#38bdf8\"/></marker><marker id=\"f3-o\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#fb923c\"/></marker><marker id=\"f3-g\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#34d399\"/></marker></defs><text x=\"14\" y=\"20\" fill=\"currentColor\" font-size=\"12\" font-weight=\"700\" text-anchor=\"start\">Ba phân tử, ba tốc độ khác nhau</text><text x=\"410\" y=\"22\" fill=\"currentColor\" font-size=\"11\" font-weight=\"600\" text-anchor=\"end\">v² rồi lấy trung bình</text><rect x=\"20\" y=\"40\" width=\"210\" height=\"120\" rx=\"8\" fill=\"rgba(148,163,184,.06)\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"50\" cy=\"65\" r=\"5\" fill=\"#38bdf8\"/><line x1=\"57\" y1=\"65\" x2=\"83\" y2=\"65\" stroke=\"#38bdf8\" stroke-width=\"2.4\"/><path d=\"M74.2,59.9 L83.0,65.0 L74.2,70.1\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.4\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"88\" y=\"69\" fill=\"#38bdf8\" font-size=\"11\" font-weight=\"700\" text-anchor=\"start\">v<tspan dy=\"4\" font-size=\"8\">1</tspan><tspan dy=\"-4\"></tspan></text><circle cx=\"50\" cy=\"105\" r=\"5\" fill=\"#38bdf8\"/><line x1=\"57\" y1=\"105\" x2=\"103\" y2=\"105\" stroke=\"#38bdf8\" stroke-width=\"2.4\"/><path d=\"M94.2,99.9 L103.0,105.0 L94.2,110.1\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.4\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"108\" y=\"109\" fill=\"#38bdf8\" font-size=\"11\" font-weight=\"700\" text-anchor=\"start\">v<tspan dy=\"4\" font-size=\"8\">2</tspan><tspan dy=\"-4\"></tspan></text><circle cx=\"50\" cy=\"145\" r=\"5\" fill=\"#38bdf8\"/><line x1=\"57\" y1=\"145\" x2=\"127\" y2=\"145\" stroke=\"#38bdf8\" stroke-width=\"2.4\"/><path d=\"M118.2,139.9 L127.0,145.0 L118.2,150.1\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.4\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"132\" y=\"149\" fill=\"#38bdf8\" font-size=\"11\" font-weight=\"700\" text-anchor=\"start\">v<tspan dy=\"4\" font-size=\"8\">3</tspan><tspan dy=\"-4\"></tspan></text><text x=\"20\" y=\"36\" fill=\"currentColor\" font-size=\"10\" font-weight=\"600\" text-anchor=\"start\">mũi tên dài = tốc độ lớn</text><line x1=\"280\" y1=\"165\" x2=\"410\" y2=\"165\" stroke=\"currentColor\" stroke-width=\"2\" opacity=\"1\"/><rect x=\"288\" y=\"157\" width=\"24\" height=\"8\" fill=\"rgba(56,189,248,.30)\" stroke=\"#38bdf8\" stroke-width=\"1.5\"/><rect x=\"320\" y=\"140\" width=\"24\" height=\"25\" fill=\"rgba(56,189,248,.30)\" stroke=\"#38bdf8\" stroke-width=\"1.5\"/><rect x=\"352\" y=\"107\" width=\"24\" height=\"58\" fill=\"rgba(56,189,248,.30)\" stroke=\"#38bdf8\" stroke-width=\"1.5\"/><text x=\"300\" y=\"181\" fill=\"currentColor\" font-size=\"11\" font-weight=\"600\" text-anchor=\"middle\">v<tspan dy=\"4\" font-size=\"8\">1</tspan><tspan dy=\"-8\" font-size=\"8\">2</tspan><tspan dy=\"4\"></tspan></text><text x=\"332\" y=\"181\" fill=\"currentColor\" font-size=\"11\" font-weight=\"600\" text-anchor=\"middle\">v<tspan dy=\"4\" font-size=\"8\">2</tspan><tspan dy=\"-8\" font-size=\"8\">2</tspan><tspan dy=\"4\"></tspan></text><text x=\"364\" y=\"181\" fill=\"currentColor\" font-size=\"11\" font-weight=\"600\" text-anchor=\"middle\">v<tspan dy=\"4\" font-size=\"8\">3</tspan><tspan dy=\"-8\" font-size=\"8\">2</tspan><tspan dy=\"4\"></tspan></text><line x1=\"282\" y1=\"134.7\" x2=\"410\" y2=\"134.7\" stroke=\"#34d399\" stroke-width=\"1.6\" stroke-dasharray=\"6 5\" opacity=\"1\"/><text x=\"410\" y=\"202\" fill=\"#34d399\" font-size=\"11\" font-weight=\"700\" text-anchor=\"end\">mức trung bình của v²</text></svg></figure>"
  },
