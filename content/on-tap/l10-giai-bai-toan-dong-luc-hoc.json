pan></text><text x=\"336.0\" y=\"186.0\" fill=\"#fb923c\" font-size=\"19\" font-weight=\"700\" text-anchor=\"end\"><tspan font-style=\"italic\" font-family=\"serif\">T</tspan></text><text x=\"336.0\" y=\"270.0\" fill=\"#f87171\" font-size=\"19\" font-weight=\"700\" text-anchor=\"end\"><tspan font-style=\"italic\" font-family=\"serif\">P</tspan><tspan baseline-shift=\"sub\" font-size=\"14\">2</tspan></text><text x=\"120.0\" y=\"98.0\" fill=\"currentColor\" font-size=\"19\" font-weight=\"700\" text-anchor=\"end\"><tspan font-style=\"italic\" font-family=\"serif\">m</tspan><tspan baseline-shift=\"sub\" font-size=\"14\">1</tspan></text><text x=\"370.0\" y=\"228.0\" fill=\"currentColor\" font-size=\"19\" font-weight=\"700\" text-anchor=\"start\"><tspan font-style=\"italic\" font-family=\"serif\">m</tspan><tspan baseline-shift=\"sub\" font-size=\"14\">2</tspan></text><line x1=\"200.0\" y1=\"92.0\" x2=\"268.0\" y2=\"92.0\" stroke=\"#34d399\" stroke-width=\"2.6\" stroke-dasharray=\"7 5\"/><path d=\"M258.6,86.6 L268.0,92.0 L258.6,97.4\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"234.0\" y=\"82.0\" fill=\"#34d399\" font-size=\"17\" font-weight=\"700\" text-anchor=\"middle\">(+)</text><line x1=\"404.0\" y1=\"176.0\" x2=\"404.0\" y2=\"238.0\" stroke=\"#34d399\" stroke-width=\"2.6\" stroke-dasharray=\"7 5\"/><path d=\"M409.4,228.6 L404.0,238.0 L398.6,228.6\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"400.0\" y=\"262.0\" fill=\"#34d399\" font-size=\"17\" font-weight=\"700\" text-anchor=\"middle\">(+)</text></svg></figure>"
