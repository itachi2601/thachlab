  {
   "id": "e5914936",
   "kieu": "lat",
   "muc": "II. Kiến thức: một quy trình, ba tình huống",
   "neo": "Bốn bước giải bài toán động lực học là gì?",
   "hoi": "Bốn bước giải bài toán động lực học là gì?",
   "dap": "<ul><li><strong>Vẽ – Kể – Viết – Chiếu.</strong> Vẽ hình, vật, trục</li><li>Kể lực (vật nào gây ra)</li><li>Viết $\\Sigma\\vec F = m\\vec a$</li><li>Chiếu lên trục, giải và kiểm</li></ul>",
   "tieu_muc": "1. Bốn bước, một cầu nối",
   "hinh": "<figure class=\"fig\" data-tl=\"1\"><svg viewBox=\"0 0 420 236\" role=\"img\" aria-label=\"Sơ đồ ba ô: các lực, gia tốc a, chuyển động. Bài toán thuận đi từ lực qua a tới chuyển động; bài toán ngược đi chiều ngược lại\"><rect x=\"12\" y=\"36\" width=\"120\" height=\"56\" rx=\"8\" fill=\"rgba(148,163,184,.15)\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"72.0\" y=\"24.0\" fill=\"currentColor\" font-size=\"17\" font-weight=\"600\" text-anchor=\"middle\">các lực</text><text x=\"72.0\" y=\"71.0\" fill=\"currentColor\" font-size=\"22\" font-weight=\"700\" text-anchor=\"middle\"><tspan font-style=\"italic\" font-family=\"serif\">ΣF</tspan></text><rect x=\"170\" y=\"36\" width=\"80\" height=\"56\" rx=\"8\" fill=\"rgba(148,163,184,.15)\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"210.0\" y=\"24.0\" fill=\"currentColor\" font-size=\"17\" font-weight=\"600\" text-anchor=\"middle\">cầu nối</text><text x=\"210.0\" y=\"71.0\" fill=\"#34d399\" font-size=\"22\" font-weight=\"700\" text-anchor=\"middle\"><tspan font-style=\"italic\" font-family=\"serif\">a</tspan></text><rect x=\"288\" y=\"36\" width=\"120\" height=\"56\" rx=\"8\" fill=\"rgba(148,163,184,.15)\" stroke=\"currentColor\" stroke-width=\"2\"/><text x=\"348.0\" y=\"24.0\" fill=\"currentColor\" font-size=\"17\" font-weight=\"600\" text-anchor=\"middle\">chuyển động</text><text x=\"348.0\" y=\"71.0\" fill=\"currentColor\" font-size=\"22\" font-weight=\"700\" text-anchor=\"middle\"><tspan font-style=\"italic\" font-family=\"serif\">v, s, t</tspan></text><line x1=\"135.0\" y1=\"52.0\" x2=\"167.0\" y2=\"52.0\" stroke=\"#34d399\" stroke-width=\"2.6\"/><path d=\"M157.6,46.6 L167.0,52.0 L157.6,57.4\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"167.0\" y1=\"76.0\" x2=\"135.0\" y2=\"76.0\" stroke=\"#f87171\" stroke-width=\"2.6\"/><path d=\"M144.4,81.4 L135.0,76.0 L144.4,70.6\" fill=\"none\" stroke=\"#f87171\" stroke-width=\"2.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"253.0\" y1=\"52.0\" x2=\"285.0\" y2=\"52.0\" stroke=\"#34d399\" stroke-width=\"2.6\"/><path d=\"M275.6,46.6 L285.0,52.0 L275.6,57.4\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"285.0\" y1=\"76.0\" x2=\"253.0\" y2=\"76.0\" stroke=\"#f87171\" stroke-width=\"2.6\"/><path d=\"M262.4,81.4 L253.0,76.0 L262.4,70.6\" fill=\"none\" stroke=\"#f87171\" stroke-width=\"2.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"12.0\" y=\"128.0\" fill=\"#34d399\" font-size=\"17\" font-weight=\"700\" text-anchor=\"start\">Thuận: biết lực → tìm chuyển động</text><text x=\"12.0\" y=\"156.0\" fill=\"#f87171\" font-size=\"17\" font-weight=\"700\" text-anchor=\"start\">Ngược: biết chuyển động → tìm lực</text><text x=\"12.0\" y=\"196.0\" fill=\"currentColor\" font-size=\"17\" font-weight=\"600\" text-anchor=\"start\">Lực ↔ a: định luật II, ΣF = ma</text><text x=\"12.0\" y=\"224.0\" fill=\"currentColor\" font-size=\"17\" font-weight=\"600\" text-anchor=\"start\">a ↔ chuyển động: công thức v, s, t</text></svg></figure>"
