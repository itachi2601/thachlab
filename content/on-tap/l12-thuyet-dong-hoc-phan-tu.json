 "the": [
  {
   "id": "ae053a00",
   "kieu": "lat",
   "muc": "II. Kiến thức",
   "neo": "Chuyển động Brown là gì? Nó chứng tỏ điều gì?",
   "hoi": "Chuyển động Brown là gì? Nó chứng tỏ điều gì?",
   "dap": "<ul><li><strong>Hạt nhỏ lơ lửng</li><li>Va đập không cân bằng</li><li>Chứng tỏ phân tử chuyển động không ngừng.</strong> Hạt phấn hoa trong nước, hạt khói trong không khí lắc lư theo đường gấp khúc, không dừng, vì bị phân tử va đập không đều từ mọi phía</li><li>Mắt không thấy phân tử, nhưng thấy hệ quả của chúng</li></ul>",
   "tieu_muc": "1. Chuyển động Brown: hạt khói trong hộp kín",
   "hinh": "<figure class=\"fig\" data-tl=\"1\"><svg viewBox=\"0 0 420 240\" role=\"img\" aria-label=\"Hạt khói ở giữa bị nhiều phân tử khí va đập từ mọi phía với mức khác nhau, nên bị đẩy lệch\"><defs><marker id=\"f1-r\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#f87171\"/></marker><marker id=\"f1-b\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#38bdf8\"/></marker><marker id=\"f1-o\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#fb923c\"/></marker><marker id=\"f1-g\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#34d399\"/></marker></defs><text x=\"14\" y=\"24\" fill=\"currentColor\" font-size=\"13\" font-weight=\"700\" text-anchor=\"start\">Hạt khói bị phân tử khí đập lệch</text><rect x=\"12\" y=\"36\" width=\"396\" height=\"190\" rx=\"12\" fill=\"rgba(148,163,184,.08)\" stroke=\"currentColor\" stroke-width=\"1.6\"/><circle cx=\"70\" cy=\"80\" r=\"5\" fill=\"#38bdf8\"/><circle cx=\"120\" cy=\"52\" r=\"5\" fill=\"#38bdf8\"/><circle cx=\"300\" cy=\"62\" r=\"5\" fill=\"#38bdf8\"/><circle cx=\"350\" cy=\"150\" r=\"5\" fill=\"#38bdf8\"/><circle cx=\"86\" cy=\"180\" r=\"5\" fill=\"#38bdf8\"/><circle cx=\"330\" cy=\"196\" r=\"5\" fill=\"#38bdf8\"/><line x1=\"76\" y1=\"84\" x2=\"186\" y2=\"106\" stroke=\"#38bdf8\" stroke-width=\"2.2\"/><path d=\"M178.9,99.7 L186.0,106.0 L177.0,109.0\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"124\" y1=\"57\" x2=\"196\" y2=\"96\" stroke=\"#38bdf8\" stroke-width=\"2.2\"/><path d=\"M191.0,87.9 L196.0,96.0 L186.5,96.3\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"296\" y1=\"67\" x2=\"226\" y2=\"98\" stroke=\"#38bdf8\" stroke-width=\"2.2\"/><path d=\"M235.4,99.0 L226.0,98.0 L231.6,90.3\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"344\" y1=\"146\" x2=\"232\" y2=\"132\" stroke=\"#38bdf8\" stroke-width=\"2.2\"/><path d=\"M239.6,137.7 L232.0,132.0 L240.7,128.3\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"92\" y1=\"176\" x2=\"192\" y2=\"142\" stroke=\"#38bdf8\" stroke-width=\"2.2\"/><path d=\"M182.7,140.2 L192.0,142.0 L185.8,149.1\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"324\" y1=\"190\" x2=\"230\" y2=\"148\" stroke=\"#38bdf8\" stroke-width=\"2.2\"/><path d=\"M235.6,155.7 L230.0,148.0 L239.4,147.0\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2.2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><circle cx=\"210\" cy=\"120\" r=\"20\" fill=\"rgba(248,113,113,.28)\" stroke=\"#f87171\" stroke-width=\"2.5\"/><circle cx=\"210\" cy=\"120\" r=\"8\" fill=\"#f87171\"/><text x=\"210\" y=\"172\" fill=\"#f87171\" font-size=\"12.5\" font-weight=\"700\" text-anchor=\"middle\">hạt khói</text><line x1=\"236\" y1=\"124\" x2=\"306\" y2=\"124\" stroke=\"#fb923c\" stroke-width=\"2.6\"/><path d=\"M296.6,118.6 L306.0,124.0 L296.6,129.4\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"2.6\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"272\" y=\"112\" fill=\"#fb923c\" font-size=\"11\" font-weight=\"700\" text-anchor=\"middle\">hạt bị đẩy lệch</text><text x=\"16\" y=\"214\" fill=\"currentColor\" font-size=\"10.5\" font-weight=\"500\" text-anchor=\"start\">chấm xanh: phân tử khí · mũi tên xanh: hướng va đập (dài ngắn khác nhau)</text></svg></figure>"
