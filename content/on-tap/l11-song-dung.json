 "lesson_title": "Sóng dừng",
 "the": [
  {
   "id": "a2f88ba5",
   "kieu": "lat",
   "muc": "II. Kiến thức: hai sóng ngược chiều gặp nhau",
   "neo": "Phản xạ trên vật cản cố định và trên vật cản tự do khác nhau",
   "hoi": "Phản xạ trên vật cản cố định và trên vật cản tự do khác nhau thế nào?",
   "dap": "<ul><li>Cố định: sóng phản xạ <strong>ngược pha</strong> sóng tới</li><li>Tự do: sóng phản xạ <strong>cùng pha</strong> sóng tới</li><li>Cả hai trường hợp đều cùng tần số, cùng bước sóng</li></ul>",
   "tieu_muc": "1. Sóng phản xạ: gặp vật cản thì quay lại"
  },
  {
   "id": "36710fd2",
   "kieu": "lat",
   "muc": "II. Kiến thức: hai sóng ngược chiều gặp nhau",
   "neo": "Nút sóng là gì, bụng sóng là gì? Biên độ mỗi loại?",
   "hoi": "Nút sóng là gì, bụng sóng là gì? Biên độ mỗi loại?",
   "dap": "<ul><li>Nút: hai sóng thành phần ngược pha, biên độ $0$</li><li>Bụng: hai sóng thành phần cùng pha, biên độ $2A$ với $A$ là biên độ sóng tới</li></ul>",
   "tieu_muc": "2. Nút sóng và bụng sóng"
  },
  {
   "id": "2949319a",
   "kieu": "lat",
   "muc": "II. Kiến thức: hai sóng ngược chiều gặp nhau",
   "neo": "Viết điều kiện có sóng dừng cho hai trường hợp, kèm số nút, ",
   "hoi": "Viết điều kiện có sóng dừng cho hai trường hợp, kèm số nút, số bụng.",
   "dap": "<ul><li><strong>Cố Định: Nút – Ngược – Nguyên</strong></li><li><strong>Tự Do: Bụng – Cùng – Lẻ.</strong> Hai đầu cố định: $l=k\\dfrac{\\lambda}{2}$ ($k=1,2,3,\\dots$), số bụng $=k$, số nút $=k+1$</li><li>Một đầu tự do: $l=(2k+1)\\dfrac{\\lambda}{4}$ ($k=0,1,2,\\dots$), số bụng = số nút $=k+1$</li></ul>",
