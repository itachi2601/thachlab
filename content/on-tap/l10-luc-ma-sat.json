roke=\"currentColor\" stroke-width=\"1.4\"/><text x=\"234.0\" y=\"107.0\" fill=\"currentColor\" font-size=\"15\" font-weight=\"700\" font-style=\"italic\" font-family=\"serif\" text-anchor=\"start\">α</text><text x=\"275.3\" y=\"66.0\" fill=\"#f87171\" font-size=\"16\" font-weight=\"700\" font-style=\"italic\" font-family=\"serif\" text-anchor=\"start\">F</text><text x=\"277.3\" y=\"100.0\" fill=\"#f87171\" font-size=\"14\" font-weight=\"700\" text-anchor=\"start\">F sinα</text><text x=\"208.0\" y=\"223.6\" fill=\"currentColor\" font-size=\"16\" font-weight=\"700\" font-style=\"italic\" font-family=\"serif\" text-anchor=\"start\">P</text><text x=\"208.0\" y=\"42.4\" fill=\"#38bdf8\" font-size=\"16\" font-weight=\"700\" font-style=\"italic\" font-family=\"serif\" text-anchor=\"start\">N</text><text x=\"155.2\" y=\"102.0\" fill=\"#fb923c\" font-size=\"16\" font-weight=\"700\" text-anchor=\"end\">F<tspan baseline-shift=\"sub\" font-size=\"14\">ms</tspan></text><text x=\"200.0\" y=\"252.0\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">N + F sinα = P</text></svg></figure>"
