   "neo": "Viết a và chỗ a_max, a_min.",
   "hoi": "Viết a và chỗ a_max, a_min.",
   "dap": "<ul><li>$a=-A\\omega^{2}\\cos(\\omega t+\\varphi)=-\\omega^{2}x$</li><li>$a_{min}=-A\\omega^{2}$ biên dương</li><li>$a_{max}=+A\\omega^{2}$ biên âm</li><li>$|a|=0$ tại O</li></ul>",
   "tieu_muc": "2. Gia tốc"
  },
