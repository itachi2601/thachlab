  {
   "id": "cdd79fbe",
   "kieu": "lat",
   "muc": "II. Kiến thức: đếm điện tích chạy qua tiết diện dây",
   "neo": "Dòng không đổi khác dòng một chiều ở chỗ nào?",
   "hoi": "Dòng không đổi khác dòng một chiều ở chỗ nào?",
   "dap": "<ul><li>Không đổi: chiều <em>và</em> cường độ không đổi</li><li>Một chiều: chỉ chiều không đổi</li><li>Không đổi là trường hợp riêng của một chiều</li></ul>",
   "tieu_muc": "3. Chiều dòng điện và dòng điện không đổi",
   "hinh": "<figure class=\"fig\" data-tl=\"1\"><svg viewBox=\"0 0 420 204\" role=\"img\" aria-label=\"Hai đồ thị cường độ dòng điện theo thời gian: bên trái đường nằm ngang là dòng không đổi, bên phải các bướu nửa sin nằm trên trục thời gian là dòng một chiều có cường độ thay đổi.\"><line x1=\"40.0\" y1=\"130.0\" x2=\"200.0\" y2=\"130.0\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M192.4,125.6 L200.0,130.0 L192.4,134.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"40.0\" y1=\"130.0\" x2=\"40.0\" y2=\"30.0\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M35.6,37.6 L40.0,30.0 L44.4,37.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"196\" y=\"148\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"end\">t</text><text x=\"28\" y=\"34\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"end\" font-family=\"Georgia, 'Times New Roman', serif\" font-style=\"italic\">I</text><text x=\"34\" y=\"146\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"end\">0</text><text x=\"110\" y=\"20\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">Không đổi</text><text x=\"34\" y=\"74\" fill=\"#f87171\" font-size=\"14\" font-weight=\"700\" text-anchor=\"end\" font-family=\"Georgia, 'Times New Roman', serif\" font-style=\"italic\">I<tspan baseline-shift=\"sub\" font-size=\"14\">0</tspan></text><line x1=\"240.0\" y1=\"130.0\" x2=\"400.0\" y2=\"130.0\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M392.4,125.6 L400.0,130.0 L392.4,134.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><line x1=\"240.0\" y1=\"130.0\" x2=\"240.0\" y2=\"30.0\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M235.6,37.6 L240.0,30.0 L244.4,37.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"miter\" stroke-miterlimit=\"10\" stroke-linecap=\"butt\"/><text x=\"396\" y=\"148\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"end\">t</text><text x=\"228\" y=\"34\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"end\" font-family=\"Georgia, 'Times New Roman', serif\" font-style=\"italic\">I</text><text x=\"234\" y=\"146\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"end\">0</text><text x=\"320\" y=\"20\" fill=\"currentColor\" font-size=\"14\" font-weight=\"700\" text-anchor=\"middle\">Một chiều</text><text x=\"234\" y=\"74\" fill=\"#f87171\" font-size=\"14\" font-weight=\"700\" text-anchor=\"end\" font-family=\"Georgia, 'Times New Roman', serif\" font-style=\"italic\">I<tspan baseline-shift=\"sub\" font-size=\"14\">0</tspan></text><polyline fill=\"none\" stroke=\"#f87171\" stroke-width=\"2.5\" stroke-linejoin=\"round\" points=\"40.0,70.0 195.0,70.0\"/><line x1=\"240.0\" y1=\"70.0\" x2=\"400.0\" y2=\"70.0\" stroke=\"currentColor\" stroke-width=\"1\" stroke-dasharray=\"3 3\" opacity=\"0.4\"/><polyline fill=\"none\" stroke=\"#f87171\" stroke-width=\"2.5\" stroke-linejoin=\"round\" points=\"240.0,130.0 242.0,120.6 244.0,111.5 246.0,102.8 248.0,94.7 250.0,87.6 252.0,81.5 254.0,76.5 256.0,72.9 258.0,70.7 260.0,70.0 262.0,70.7 264.0,72.9 266.0,76.5 268.0,81.5 270.0,87.6 272.0,94.7 274.0,102.8 276.0,111.5 278.0,120.6 280.0,130.0 282.0,120.6 284.0,111.5 286.0,102.8 288.0,94.7 290.0,87.6 292.0,81.5 294.0,76.5 296.0,72.9 298.0,70.7 300.0,70.0 302.0,70.7 304.0,72.9 306.0,76.5 308.0,81.5 310.0,87.6 312.0,94.7 314.0,102.8 316.0,111.5 318.0,120.6 320.0,130.0 322.0,120.6 324.0,111.5 326.0,102.8 328.0,94.7 330.0,87.6 332.0,81.5 334.0,76.5 336.0,72.9 338.0,70.7 340.0,70.0 342.0,70.7 344.0,72.9 346.0,76.5 348.0,81.5 350.0,87.6 352.0,94.7 354.0,102.8 356.0,111.5 358.0,120.6 360.0,130.0 362.0,120.6 364.0,111.5 366.0,102.8 368.0,94.7 370.0,87.6 372.0,81.5 374.0,76.5 376.0,72.9 378.0,70.7 380.0,70.0 382.0,70.7 384.0,72.9 386.0,76.5 388.0,81.5 390.0,87.6 392.0,94.7 394.0,102.8 396.0,111.5 398.0,120.6 400.0,130.0\"/><text x=\"12\" y=\"176\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"start\">cả hai: chiều không đổi</text><text x=\"12\" y=\"196\" fill=\"currentColor\" font-size=\"14\" font-weight=\"600\" text-anchor=\"start\">chỉ bên trái cường độ cũng không đổi</text></svg></figure>"
