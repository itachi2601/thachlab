# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/settings.local.json

# thư mục tạm / sản phẩm trung gian
/output/
/tmp/
/scratchpad/

# supabase CLI (trạng thái link cục bộ trên máy, không phải cấu hình chung)
/supabase/.temp/

# bản gốc ảnh trước khi nén (scripts/optimize-images.mjs)
/public/_originals/

# học liệu tĩnh sinh lúc build (scripts/build-content.mjs) — không commit
/public/data/
scripts/logs/
public/xem-thu/
scripts/data/gemini-hinh/cau/
scripts/data/gemini-hinh/out/
scripts/data/gemini-hinh/svg/
scripts/data/gemini-hinh/so-sanh.html
scripts/data/kiem-ke-anh-ngan-hang/rows.json

# dữ liệu trung gian giải lại ngân hàng (nặng, sinh lại được bằng scripts/*giai-lai*)
scripts/data/giai-lai/
scripts/data/giai-lai-thu/
scripts/data/nap-ngan-hang-vl10/nguon/
scripts/data/nap-ngan-hang-vl10/media/
scripts/data/nap-ngan-hang-vl10/*/nguon/
scripts/data/nap-ngan-hang-vl10/*/media/
scripts/ruot-tap/out/*.html
scripts/data/nap-ngan-hang-vl12/*/nguon/
scripts/data/nap-ngan-hang-vl12/*/media/
