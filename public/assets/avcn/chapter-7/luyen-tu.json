{"chapter":7,"title":"Metal Forming and Casting","words":[{"term":"metal-forming","vi":"gia công kim loại bằng biến dạng, tạo hình kim loại","audio":"/assets/avcn/chapter-7/audio/b8bfdd1bb5.mp3"},{"term":"hot-working","vi":"gia công nóng","audio":"/assets/avcn/chapter-7/audio/49288c6aeb.mp3"},{"term":"cold-working","vi":"gia công nguội","audio":"/assets/avcn/chapter-7/audio/452e860b3d.mp3"},{"term":"rolling","vi":"cán (kim loại)","ipa":"/ˈrəʊlɪŋ/","audio":"/assets/avcn/chapter-7/audio/76dcb7f96c.mp3"},{"term":"forging","vi":"rèn","ipa":"/ˈfɔːdʒɪŋ/","audio":"/assets/avcn/chapter-7/audio/65825dbcbc.mp3"},{"term":"bending","vi":"uốn, gập","ipa":"/ˈbendɪŋ/","audio":"/assets/avcn/chapter-7/audio/206dd6f584.mp3"},{"term":"deep drawing","vi":"dập vuốt sâu","audio":"/assets/avcn/chapter-7/audio/fbb79ebc58.mp3"},{"term":"spinning","vi":"ép tạo hình quay (miết)","ipa":"/ˈspɪnɪŋ/","audio":"/assets/avcn/chapter-7/audio/7697c340a4.mp3"},{"term":"piercing","vi":"đột lỗ","ipa":"/ˈpɪəsɪŋ/","audio":"/assets/avcn/chapter-7/audio/279ac7c082.mp3"},{"term":"shearing","vi":"cắt (tấm kim loại bằng hai lưỡi cắt)","ipa":"/ˈʃɪərɪŋ/","audio":"/assets/avcn/chapter-7/audio/35760e44ab.mp3"},{"term":"casting","vi":"đúc","ipa":"/ˈkɑːstɪŋ/","audio":"/assets/avcn/chapter-7/audio/e6bf0bdd68.mp3"},{"term":"sand casting","vi":"đúc cát","audio":"/assets/avcn/chapter-7/audio/76809cdfd7.mp3"},{"term":"investment casting","vi":"đúc sáp chảy (đúc mẫu chảy)","audio":"/assets/avcn/chapter-7/audio/295f800b10.mp3"},{"term":"molten","vi":"nóng chảy, ở thể lỏng","ipa":"/ˈməʊltən/","audio":"/assets/avcn/chapter-7/audio/0f6ef96e5f.mp3"},{"term":"mould","vi":"khuôn đúc (tiếng Mỹ: mold; đời thường còn là nấm mốc)","ipa":"/məʊld/","audio":"/assets/avcn/chapter-7/audio/a6a7817339.mp3"},{"term":"die","vi":"khuôn (khuôn dập, khuôn ép; đời thường: chết, con xúc xắc)","ipa":"/daɪ/","audio":"/assets/avcn/chapter-7/audio/aa60f2ec35.mp3"},{"term":"pattern","vi":"mẫu đúc (đời thường: hoa văn)","ipa":"/ˈpætn/","audio":"/assets/