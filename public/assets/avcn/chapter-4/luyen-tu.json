{"chapter":4,"title":"Measurements","words":[{"term":"metric","vi":"hệ mét (mét, lít, kilôgam)","ipa":"/ˈmetrɪk/","audio":"/assets/avcn/chapter-4/audio/5f181f76dd.mp3"},{"term":"imperial","vi":"hệ imperial (inch, quart, pound)","ipa":"/ɪmˈpɪəriəl/","audio":"/assets/avcn/chapter-4/audio/c2a5dcaed8.mp3"},{"term":"conversion","vi":"sự đổi (từ hệ đo này sang hệ đo khác)","ipa":"/kənˈvɜːʃn/","audio":"/assets/avcn/chapter-4/audio/1a6af5a081.mp3"},{"term":"round off","vi":"làm hỏng, làm mòn tròn (bu lông, vít)","ipa":"/ˌraʊnd ˈɒf/","audio":"/assets/avcn/chapter-4/audio/f1d450d873.mp3"},{"term":"quart","vi":"quart (đơn vị thể tích imperial, gần 1 lít)","ipa":"/kwɔːt/","audio":"/assets/avcn/chapter-4/audio/424f00d863.mp3"},{"term":"liter","vi":"lít","ipa":"/ˈliːtə/","audio":"/assets/avcn/chapter-4/audio/bb0111475e.mp3"},{"term":"centimeter","vi":"xentimét","ipa":"/ˈsentɪmiːtə/","audio":"/assets/avcn/chapter-4/audio/9c206450e8.mp3"},{"term":"pound","vi":"pound, cân Anh (≈ 0,45 kg)","ipa":"/paʊnd/","audio":"/assets/avcn/chapter-4/audio/5be22f25f9.mp3"},{"term":"kilogram","vi":"kilôgam","ipa":"/ˈkɪləɡræm/","audio":"/assets/avcn/chapter-4/audio/5026dea1e2.mp3"},{"term":"cubic inch","vi":"inch khối","ipa":"/ˌkjuːbɪk ˈɪntʃ/","audio":"/assets/avcn/chapter-4/audio/9c88610a7e.mp3"},{"term":"micrometer","vi":"panme (dụng cụ đo khoảng cách rất nhỏ)","ipa":"/maɪˈkrɒmɪtə/","audio":"/assets/avcn/chapter-4/audio/4967b8e525.mp3"},{"term":"vernier caliper","vi":"thước cặp","ipa":"/ˌvɜːniə ˈkælɪpə/","audio":"/assets/avcn/chapter-4/audio/96bc07f8f2.mp3"},{"term":"outside micrometer","vi":"panme đo ngoài (khung chữ C)","ipa":"/ˌaʊtˈsaɪd maɪˈkrɒmɪtə/","audio":"/assets/avcn/chapter-4/audio/e4bc940d37.mp3"},{"term":"inside micrometer","vi":"panme đo trong","ipa":"/ˌɪnˈsaɪd maɪˈkrɒmɪtə/","audio":"/assets/avcn/chapter-4/audio/8c1e75b367.mp3"},{"term":"depth micrometer","vi":"panme đo sâu","ipa":"/ˈdepθ maɪˈkrɒmɪtə/","audio":"/assets/avcn/chapter-4/audio/a267884e37.mp3"},{"term":"tolerance","vi":"dun