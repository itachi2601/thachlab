{"chapter":3,"title":"Hand Tools","words":[{"term":"hand tool","vi":"dụng cụ cầm tay","ipa":"/hænd tuːl/","audio":"/assets/avcn/chapter-3/audio/61c078aed1.mp3"},{"term":"hardware","vi":"đồ ngũ kim (hardware store = cửa hàng ngũ kim; đời thường còn là phần cứng máy tính)","ipa":"/ˈhɑːdweə/","audio":"/assets/avcn/chapter-3/audio/2782a00d69.mp3"},{"term":"tool kit","vi":"bộ dụng cụ (hộp đựng nhiều dụng cụ)","ipa":"/tuːl kɪt/","audio":"/assets/avcn/chapter-3/audio/9c5eb030f3.mp3"},{"term":"retractable","vi":"thụt vào được, kéo vào được","ipa":"/rɪˈtræktəbl/","audio":"/assets/avcn/chapter-3/audio/846830df84.mp3"},{"term":"adjustable","vi":"chỉnh được, thay đổi cỡ được","ipa":"/əˈdʒʌstəbl/","audio":"/assets/avcn/chapter-3/audio/e46f5da289.mp3"},{"term":"wrench","vi":"cờ lê","ipa":"/rentʃ/","audio":"/assets/avcn/chapter-3/audio/3469abbe38.mp3"},{"term":"screwdriver","vi":"tua vít","ipa":"/ˈskruːdraɪvə/","audio":"/assets/avcn/chapter-3/audio/e681e39b58.mp3"},{"term":"phillips screwdriver","vi":"tua vít đầu chữ thập (bốn cạnh)","ipa":"/ˈfɪlɪps ˈskruːdraɪvə/","audio":"/assets/avcn/chapter-3/audio/68e441aeeb.mp3"},{"term":"flathead screwdriver","vi":"tua vít đầu dẹt","ipa":"/ˈflæthed ˈskruːdraɪvə/","audio":"/assets/avcn/chapter-3/audio/d135a87343.mp3"},{"term":"claw hammer","vi":"búa nhổ đinh","ipa":"/klɔː ˈhæmə/","audio":"/assets/avcn/chapter-3/audio/85ec656e43.mp3"},{"term":"pliers","vi":"kìm","ipa":"/ˈplaɪəz/","audio":"/assets/avcn/chapter-3/audio/08f6ae65ef.mp3"},{"term":"slip-joint pliers","vi":"kìm mở được hai cỡ (khớp trượt)","ipa":"/slɪp dʒɔɪnt ˈplaɪəz/","audio":"/assets/avcn/chapter-3/audio/c33c71ace2.mp3"},{"term":"long-nose pliers","vi":"kìm mũi nhọn dài","ipa":"/lɒŋ nəʊz ˈplaɪəz/","audio":"/assets/avcn/chapter-3/audio/a9e3d6c45c.mp3"},{"term":"diagonal cutters","vi":"kìm cắt chéo","ipa":"/daɪˈæɡənl ˈkʌtəz/","audio":"/assets/avcn/chapter-3/audio/9560d40ea1.mp3"},{"term":"wire strippers","vi":"kìm tuốt dây điện","ipa":"/ˈwaɪə ˈstrɪpəz/","audio":"/assets/avcn/chapter-